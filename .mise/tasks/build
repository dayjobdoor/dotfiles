#!/usr/bin/env bash
#MISE description="Build the Docker image (djd:latest, agent module on the base with the desktop), or the CI-only full flavor (djd:full)"
#USAGE arg "[flavor]" default="latest" { choices "latest" "full"; }
set -euo pipefail
cd "$(dirname "$0")/../.."

flavor=${usage_flavor:-${1:-latest}}
case $flavor in
latest) modules=agent ;;
full) modules="agent full" ;;
*)
    echo "usage: build [latest|full]" >&2
    exit 2
    ;;
esac
# The token reaches the build only as a BuildKit secret, never as ARG/ENV. No fallback to `gh auth token`: it carries every scope (SECURITY.md#github-tokens)
if [ -z "${GITHUB_TOKEN+x}" ]; then
    echo "$0: set GITHUB_TOKEN to a token without scopes (classic with none, or fine-grained with no permissions), or GITHUB_TOKEN= for none; \`gh auth token\` would hand the installs every scope of your login (SECURITY.md#github-tokens)" >&2
    exit 1
fi
export GITHUB_TOKEN
docker build -f .devcontainer/Dockerfile --build-arg DJD_MODULES="$modules" \
    --build-arg DJD_REVISION="$(git describe --always --dirty 2>/dev/null || echo unknown)" \
    --secret id=github_token,env=GITHUB_TOKEN -t "djd:$flavor" .
