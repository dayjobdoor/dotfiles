#!/usr/bin/env bash
#MISE description="mise TOML formatting, task definitions (djd included) and the pinned mise release"
#USAGE flag "--fix" help="Rewrite TOML formatting instead of reporting it"
set -euo pipefail
cd "$(dirname "$0")/../../.."

fix=${usage_fix:-false}

# --stdin, because mise only formats configs it would load from the current directory
for f in .mise/config.toml mise-config/*.toml; do
    # machine-local overrides are gitignored, and --fix must never rewrite them
    case "$f" in *.local.toml) continue ;; esac
    formatted=$(mise fmt --stdin <"$f")
    if [ "$fix" = true ]; then
        printf '%s\n' "$formatted" >"$f"
    elif ! diff -u "$f" - <<<"$formatted"; then
        echo "lint: $f is not formatted; run mise run lint:fix" >&2
        exit 1
    fi
done
mise tasks validate
# mise-config as the global config, so the djd tasks and their usage specs are validated too; the repo tasks are
# loaded as well and checked a second time (mise has no way to select only the global ones)
MISE_CONFIG_DIR="$PWD/mise-config" mise tasks validate
# The mise release is pinned in several places that no bot bumps; they must name the same one (install.sh pins
# none: it reads min_version). A pin whose line stops matching its sed would silently drop out of the comparison,
# so every source must yield its count.
pins=
collect() { # source, expected number of pins, then the pins that the source's sed found
    local from=$1 want=$2
    shift 2
    if [ $# -ne "$want" ]; then
        echo "lint: $from has $# mise version pin(s) in the expected form, want $want" >&2
        exit 1
    fi
    [ $# -eq 0 ] || pins+=$(printf '%s\n' "$@")$'\n'
}
# unquoted: the words are the pins, and none contains a space
# shellcheck disable=SC2046
{
    for f in .mise/config.toml mise-config/config.toml; do
        collect "$f" 1 $(sed -n 's/^min_version = "\(.*\)"$/\1/p' "$f")
    done
    for f in .github/workflows/*.yaml; do
        count=$(awk '/^[ \t]*-[ \t]+uses:[ \t]*jdx\/mise-action@/ { n++ } END { print n + 0 }' "$f")
        mapfile -t action_pins < <(awk '
            /^[ \t]*-[ \t]+/ { mise_action = 0 }
            /^[ \t]*-[ \t]+uses:[ \t]*jdx\/mise-action@/ { mise_action = 1 }
            mise_action && $1 == "version:" && $2 ~ /^[0-9][0-9.]*$/ { print $2 }
        ' "$f")
        collect "$f" "$count" "${action_pins[@]}"
    done
}
if [ "$(sort -u <<<"$pins" | grep -c .)" -ne 1 ]; then
    echo "lint: the mise versions in .mise/config.toml, mise-config/config.toml and the mise-action pins differ:" >&2
    sort <<<"$pins" | grep . | uniq -c >&2
    exit 1
fi
# pi reads AGENTS.md and omp reads RULES.md; they are meant to be the same text, and nothing else keeps them so
if ! cmp -s home/.config/pi/agent/AGENTS.md home/.config/omp/profiles/god/agent/RULES.md; then
    echo "lint: home/.config/pi/agent/AGENTS.md and home/.config/omp/profiles/god/agent/RULES.md differ; keep them identical" >&2
    exit 1
fi
echo "ok mise"
