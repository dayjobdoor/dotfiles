#!/usr/bin/env bash
#MISE description="gitleaks over the git history, or over the files when there is no git directory"
#MISE tools={gitleaks="latest"}
set -euo pipefail
cd "$(dirname "$0")/../../.."

# a worktree's .git is a file, so ask git instead of testing for a directory
if git rev-parse --git-dir >/dev/null 2>&1; then
    gitleaks git --redact --no-banner
else
    # a copy of the tracked files without history (the no-trust flow in AGENTS.md)
    gitleaks dir --redact --no-banner .
fi
echo "ok secrets"
