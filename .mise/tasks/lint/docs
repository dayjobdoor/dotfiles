#!/usr/bin/env bash
#MISE description="Markdown links and anchors, and the repo paths, commands and DJD_ variables that the docs name, resolve; every DJD_ variable and tests/ script is documented"
set -euo pipefail
cd "$(dirname "$0")/../../.."

docs="README.md AGENTS.md SECURITY.md DESIGN.md ROADMAP.md CHANGELOG.md llms.txt docs/*.md"

broken=0
# shellcheck disable=SC2086
for f in $docs; do
    while IFS= read -r link; do
        case $link in http://* | https://* | mailto:*) continue ;; esac
        path=${link%%#*}
        anchor=
        case $link in *'#'*) anchor=${link#*#} ;; esac
        if [ -z "$path" ]; then target=$f; else target=$(dirname "$f")/$path; fi
        if [ ! -e "$target" ]; then
            echo "lint: $f links to a missing file: $link" >&2
            broken=1
        elif [ -n "$anchor" ] && [ -f "$target" ]; then
            # GitHub's heading slugs decide what an anchor is
            # fences skipped like the span extractor below: a `# comment` in a code block is no heading
            slugs=$(awk '/^[ \t]*```/ { fence = !fence; next } !fence && /^#+ /' "$target" | sed -E 's/^#+ +//' | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9 _-]//g; s/ /-/g' | awk '
                {
                    slug = $0
                    if (slug in occurrences) {
                        base = slug
                        do {
                            occurrences[base]++
                            slug = base "-" occurrences[base]
                        } while (slug in occurrences)
                    }
                    occurrences[slug] = 0
                    print slug
                }
            ')
            # a here-string, not a pipe: grep -q exiting early would SIGPIPE the producer under pipefail
            if ! grep -qxF -- "$anchor" <<<"$slugs"; then
                echo "lint: $f links to a missing anchor: $link" >&2
                broken=1
            fi
        fi
    done < <(grep -o '](\([^)]*\))' "$f" | sed 's/^](//; s/)$//' || true)
done

# Inline code spans outside fenced blocks, as FILE<TAB>LINE<TAB>span
# shellcheck disable=SC2086
spans=$(awk '
    /^[ \t]*```/ { fence = !fence; next }
    fence { next }
    {
        n = split($0, part, "`")
        for (i = 2; i <= n; i += 2) printf "%s\t%d\t%s\n", FILENAME, FNR, part[i]
    }' $docs)

fail() {
    echo "lint: $1:$2: $3" >&2
    broken=1
}

# gitignored, so absent in a fresh checkout
# agent (a module) and desktop (the compose service before it became ubuntu): their directories were folded into home/ and still
# count as past top-level names
allow_paths=" .devcontainer/.env agent desktop "
# These slash paths name tool configuration, external resources or shorthand below a documented directory, not a
# checkout root. Any other unknown root must resolve instead of disappearing from the path check.
non_repo_roots=" .config/ Asia/ bash/ bin/ djd/ distribution/ gh/ ghcr.io/ git/ hooks/ images:ubuntu/ jdx/ lazydocker/ linux/ repos/ resources/ ripgrep/ rclone/ state/ unknown/ zsh/ "
# djd menu: planned in ROADMAP.md, not implemented
allow_cmds=" djd:menu "

# Top-level names that a path may start with: those now, and those of every commit when there is a git history
# (CI fetches all of it; the docker lint run has no .git and checks only the names that exist), so a reference
# to a renamed or deleted file or directory is reported instead of skipped as prose.
roots=" "
for p in * .[!.]*; do [ "$p" = .git ] || roots="$roots$p "; done
if git rev-parse --git-dir >/dev/null 2>&1; then
    while IFS= read -r p; do roots="$roots$p "; done < <(git -c core.quotePath=false log --all --name-only --pretty=format: | sed 's|/.*||' | sort -u)
fi
djd=" "
for p in mise-config/tasks/djd/*; do djd="$djd${p##*/} "; done
tasks=" $(find .mise/tasks -type f | sed 's|^.mise/tasks/||; s|/_default$||; s|/|:|g' | tr '\n' ' ')"
tasks="$tasks $(sed -nE 's/^\[tasks\."?([^]"]+)"?\]$/\1/p' .mise/config.toml | tr '\n' ' ')"

while IFS=$'\t' read -r f line span; do
    # 1. repo paths: a token is one when it is no ~, absolute, URL, $, flag, <placeholder> or pattern (* < > { } [ ] | = @)
    # once trailing punctuation, a leading ./ and a trailing / are dropped, and it starts with a top-level name
    read -ra toks <<<"$span" # an array, so a glob character in a span is not expanded
    for tok in "${toks[@]}"; do
        while [[ $tok =~ [,.\;:\)]$ ]]; do tok=${tok%?}; done
        tok=${tok#./}
        case $tok in '' | '~'* | /* | http://* | https://* | '$'* | -* | '<'*) continue ;; esac
        case $tok in *[*\<\>{}\[\]\|=@]*) continue ;; esac
        tok=${tok%/}
        case $roots in
        *" ${tok%%/*} "*) ;;
        *)
            case $tok in */*) ;; *) continue ;; esac
            case $non_repo_roots in *" ${tok%%/*}/ "*) continue ;; esac
            fail "$f" "$line" "missing path: $tok"
            continue
            ;;
        esac
        case $allow_paths in *" $tok "*) continue ;; esac
        [ -e "$tok" ] || fail "$f" "$line" "missing path: $tok"
    done
    # 2. commands: after `mise run` and `djd`, only the first word that is no flag
    while IFS= read -r cmd; do
        # a quote that closes the command inside a span, as in `zsh -lc 'djd doctor'`: the one a value does not balance
        for q in \' \"; do
            only=${cmd//[^$q]/}
            if [ $((${#only} % 2)) -eq 1 ] && [[ $cmd == *"$q" ]]; then cmd=${cmd%"$q"}; fi
        done
        prog=${cmd%% *}
        rest=${cmd#"$prog "}
        [ "$prog" != mise ] || rest=${rest#run }
        # NAME=value arguments are no tasks, a quoted value included
        read -ra names <<<"$(sed -E 's/[A-Za-z_]+=("[^"]*"|[^ ]*)//g' <<<"$rest")"
        [ ${#names[@]} -gt 0 ] || continue
        while [ ${#names[@]} -gt 1 ] && [[ ${names[0]} == -* ]]; do names=("${names[@]:1}"); done
        names=("${names[0]}")
        case $prog in
        djd) ok=$djd ;;
        *) ok="$tasks${djd// / djd:}" ;;
        esac
        for name in "${names[@]}"; do
            case $name in '' | -* | '<'* | '$'* | '['* | *'<'* | *'|'*) continue ;; esac
            case $allow_cmds in *" $prog:$name "*) continue ;; esac
            case $ok in *" $name "*) ;; *) fail "$f" "$line" "unknown command: $cmd" ;; esac
        done
    done < <(grep -oE '(^|[^[:alnum:]_.:/-])(mise run|djd) [^&|;]+' <<<"$span" | sed -E 's/^[^a-z]//' || true)
done <<<"$spans"

# 3. DJD_ variables
code="install.sh home mise-config .mise/tasks tests .devcontainer .github .mise/config.toml"
# --exclude=docs matches file names, not directories: it skips this script (.mise/tasks/lint/docs), so a variable it only
# mentions in its own text does not count as found in code. No directory in $code is named docs.
# shellcheck disable=SC2086
known=$(grep -rhoE --exclude=docs 'DJD_[A-Z][A-Z0-9_]*' $code | sort -u)
for f in $docs; do
    while IFS=: read -r line var; do
        grep -qxF -- "$var" <<<"$known" || fail "$f" "$line" "variable not found in code: $var"
    done < <(grep -noE 'DJD_[A-Z][A-Z0-9_]*' "$f" || true)
done

# the other way round: a variable in code that no doc names. DJD_BAD, DJD_CHECK and DJD_CHECK2 are secret names that `mise run test`
# makes up.
allow_vars=" DJD_BAD DJD_CHECK DJD_CHECK2 "
# shellcheck disable=SC2086
documented=$(grep -hoE 'DJD_[A-Z][A-Z0-9_]*' $docs | sort -u)
# shellcheck disable=SC2086
while IFS= read -r var; do
    case $allow_vars in *" $var "*) continue ;; esac
    grep -qxF -- "$var" <<<"$documented" || {
        echo "lint: variable in code but in no doc: $var" >&2
        broken=1
    }
done < <(grep -rhoE --exclude=docs 'DJD_[A-Z][A-Z0-9_]*' $code | sort -u)

# 4. test scripts: each is listed in directory.md and run by a task. A task names a test by its path, or by its bare
# name in a list of test:offline. A bare name that occurs in any task file passes, so tighten the pattern if a test
# gets a common word for a name.
for t in tests/*.sh; do
    name=${t##*/}
    grep -qF -- "$name" docs/directory.md || {
        echo "lint: docs/directory.md does not name $t" >&2
        broken=1
    }
    grep -rqE -- "[ \"/]${name%.sh}(\.sh|[ \"])" .mise/tasks || {
        echo "lint: no task in .mise/tasks/ runs $t" >&2
        broken=1
    }
done

[ "$broken" -eq 0 ] || exit 1
echo "ok docs links, paths, commands, variables and tests"
