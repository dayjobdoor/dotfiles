#!/usr/bin/env bash
#MISE description="Offline tests (no network, no token) on the current tree inside an existing djd:latest, without a build"
#USAGE arg "[test]..." var=#true help="Tests to run; all four by default" { choices "xsession-audio" "tree-check" "djd-module" "server-hooks"; }
#USAGE flag "--image <image>" default="djd:latest" help="Image to run them in"
set -euo pipefail
trap 'echo "FAIL line $LINENO: $BASH_COMMAND" >&2' ERR

cd "$(dirname "$0")/../../.."
image=${usage_image:-djd:latest}
read -ra tests <<<"${usage_test:-xsession-audio tree-check djd-module server-hooks}"

# The tree is streamed in, so a fix is tested without rebuilding the image. One container per test: they share no
# state, and none has a network, so "offline" is enforced. --hostname localhost: without it, under --network none,
# sudo prints "unable to resolve host".
for t in "${tests[@]}"; do
    echo "== $t" >&2
    tests/tree.sh | docker run --rm -i --init --network none --hostname localhost "$image" bash -c \
        'mkdir /tmp/w && tar -xf - -C /tmp/w && bash "/tmp/w/tests/$0.sh"' "$t"
done
