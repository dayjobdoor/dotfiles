#!/usr/bin/env bash
#MISE description="The image: offline tests, doctor (green and red), PATH, shell startup, backup and checkout re-apply, secrets round trip (builds it first)"
#MISE depends=["build"]
#USAGE arg "[image]" default="djd:latest" help="Image to test"
set -euo pipefail
# set -e alone fails silently; name the check that stopped the run. GitHub lists ::error:: lines as annotations,
# which `gh run view` shows without the log; the command is cut to one short line, and its text holds no secret
# because the token is only ever forwarded by name.
on_err() {
    echo "FAIL line $1: $2" >&2
    [ -z "${GITHUB_ACTIONS:-}" ] || printf '::error::test line %s: %.300s\n' "$1" "${2//$'\n'/ }"
}
trap 'on_err "$LINENO" "$BASH_COMMAND"' ERR

image=${usage_image:-${1:-djd:latest}}
ok() { echo "ok $*"; }
# exported so that the `docker run -e MISE_GITHUB_TOKEN` flags below forward it from the environment instead of
# putting it on the command line
export MISE_GITHUB_TOKEN="${GITHUB_TOKEN:-}"

# The tests/ scripts that need no network and no token (test/offline, which also runs alone on a built image).
# They are fast, and a failure here says more than the same fault found by the long steps below. Called as a
# script, not through `mise run`: that would install the repo's tools on the host and fail on an untrusted checkout.
usage_image="$image" "$(dirname "$0")/offline"
ok offline tests

# `docker run IMAGE djd doctor` is the green path. The red paths run in a zsh -lc script, so every check goes
# through doctor_says: zsh has no pipefail, and a `djd doctor | grep -q` would pass whatever doctor exits with.
# Doctor's other checks fail in these containers (a missing sshd), which is why `ok` lines are matched
# by name and only a FAIL line also requires the non-zero exit.
doctor_lib=$(
    cat <<'EOF'
set -e
step() { echo "== $*" >&2; }
# doctor_says <ok|FAIL> <check> [pattern that must also appear in the output]
doctor_says() {
    rc=0
    out=$(djd doctor 2>&1) || rc=$?
    if ! grep -qE "^$1 $2([ :]|\$)" <<<"$out"; then
        echo "doctor printed no '$1 $2' line:" >&2
        echo "$out" >&2
        exit 1
    fi
    if [ "$1" = FAIL ] && [ "$rc" = 0 ]; then
        echo "doctor exited 0 with $2 failing" >&2
        exit 1
    fi
    if [ -n "${3:-}" ] && ! grep -q -- "$3" <<<"$out"; then
        echo "doctor output lacks '$3':" >&2
        echo "$out" >&2
        exit 1
    fi
}
EOF
)

# the checks that apply to the plain image (no server or secrets selected) must each print their ok line:
# a doctor that skipped one would still exit 0
out=$(docker run --rm "$image" djd doctor 2>&1) || {
    printf '%s\n' "$out" >&2
    exit 1
}
for check in ubuntu mise-config login-shell bootstrap dotfiles plugins xrdp-tls xrdp-root-login; do
    grep -qx "ok $check" <<<"$out" || {
        printf 'djd doctor printed no "ok %s" line:\n%s\n' "$check" "$out" >&2
        exit 1
    }
done
# `docker run IMAGE tool` and `docker exec` get no login shell; the image PATH must carry the shims
docker run --rm "$image" rg --version >/dev/null
ok tools on PATH without a login shell
# the archives that mise downloaded stay out of the image: they are a second copy of every tool (1.2 GB)
if docker run --rm "$image" sh -c 'test -e ~/.cache/mise/downloads-cas'; then
    echo "the image keeps ~/.cache/mise/downloads-cas, a second copy of every tool" >&2
    exit 1
fi
ok the mise download cache is not in the image
# env -i drops the image's ENV PATH, so only ~/.profile can put the shims there (agents start shells this way)
docker run --rm "$image" env -i HOME=/home/dayjobdoor bash -lc 'rg --version' >/dev/null
ok .profile puts the shims on PATH

# the agent module's [env] reaches a shimmed tool in a plain `docker run`, and pi and omp each get their config
# PI_TELEMETRY is 0 and DO_NOT_TRACK is 1, so node prints their concatenation: 01
docker run --rm "$image" sh -c 'node -p "process.env.PI_TELEMETRY + process.env.DO_NOT_TRACK"' | grep -qx 01
docker run --rm "$image" sh -c 'node -p "process.env.PI_CODING_AGENT_DIR + process.env.OMP_PROFILE"' | grep -qx "/home/dayjobdoor/.config/pi/agentgod"
# the global instructions are links into the checkout's home/.config, and not empty
docker run --rm "$image" zsh -lc '
    set -e
    for f in .config/pi/agent/AGENTS.md .config/omp/profiles/god/agent/RULES.md; do
        test -L "$HOME/$f"
        test -s "$HOME/$f"
        [ "$(readlink -f "$HOME/$f")" = "$HOME/.dotfiles/home/$f" ]
    done
'
ok agent env without a login shell, pi and omp config
# an alias replaces a command and is a mise [shell_alias]; a shortcut is a zsh-abbr abbreviation (never both)
docker run --rm "$image" mise shell-alias get cat | grep -qx 'bat -p'
docker run --rm "$image" mise shell-alias get tree | grep -qx 'tree -C'
if docker run --rm "$image" mise shell-alias get ll >/dev/null 2>&1; then
    echo "ll is a mise shell_alias, but it is a shortcut and belongs in zsh-abbr" >&2
    exit 1
fi
if docker run --rm "$image" mise shell-alias get nosuch >/dev/null 2>&1; then
    echo "mise shell-alias get succeeds for an alias that does not exist, so the check on ll proves nothing" >&2
    exit 1
fi
ok shell aliases come from mise
# sheldon fetched the pinned plugins (offline: the image holds them), zsh-abbr loads with its submodule zsh-job-queue
# and reads the abbreviations file, and a login zsh has zsh-defer. No .functions file is left to source.
# no `set -e` here: zsh-abbr's own file returns non-zero on its last line, which errexit would turn into a failure
docker run --rm "$image" zsh -lc '
    f=$(sheldon source | sed -n "s/^zsh-defer source \"\(.*zsh-abbr.plugin.zsh\)\"$/\1/p")
    [ -r "$f" ] || exit 1
    [ -r "${f:h}/zsh-job-queue/zsh-job-queue.zsh" ] || exit 2
    source $f
    abbr list | grep -qxF "\"ll\"=\"ls -l\"" || exit 3
    abbr list | grep -qxF "\"lh\"=\"xdg-open http://localhost:3000\"" || exit 4
    [ ! -e ~/.config/zsh/.functions ] || exit 5
'
out=$(docker run --rm -t "$image" zsh -ic 'whence -w zsh-defer' | tr -d '\r')
grep -q 'function' <<<"$out" || {
    printf 'zsh-defer is not loaded in an interactive shell: %s\n' "$out" >&2
    exit 1
}
ok sheldon plugins, zsh-abbr abbreviations

# Every start is interactive, on a tty. Two caches are involved: the first zsh start fills the zsh init cache, so
# its output is dropped (the plugins are bootstrap checkouts, not fetched at shell start). The second zsh start
# reads that cache. The bash start fills its own, separate cache and is cold too, yet must be silent. Anything
# printed is a broken init script.
out=$(docker run --rm -t "$image" zsh -c 'zsh -ic true >/dev/null 2>&1; zsh -ic true; bash -ic true' | tr -d '\r')
[ -z "$out" ] || {
    printf 'interactive shell startup printed:\n%s\n' "$out" >&2
    exit 1
}
ok interactive shells start silently

# Stub banner tools, each with its own output, so that a branch of .zlogin that is gone or wired to the wrong
# tool changes the expected text: fortune | cowsay prints COW, figlet | lolcat prints LOL. fastfetch stands in for
# the goodbye that .zlogout prints when an interactive login shell exits. A login shell that runs a command
# (agents, `zsh -lc`, `zsh -lic`) must not mix the banner into the command's output, and an interactive one that
# reads commands from stdin must still show it (or the stubs would prove nothing). Each banner branch needs both of its tools.
docker run --rm "$image" bash -c '
    set -e
    mkdir /tmp/stub /tmp/stub-cow
    printf "#!/bin/sh\n:\n" >/tmp/stub/fortune
    printf "#!/bin/sh\n:\n" >/tmp/stub/figlet
    printf "#!/bin/sh\necho COW\n" >/tmp/stub/cowsay
    printf "#!/bin/sh\necho LOL\n" >/tmp/stub/lolcat
    printf "#!/bin/sh\necho BYE\n" >/tmp/stub/fastfetch
    chmod +x /tmp/stub/*
    cp /tmp/stub/cowsay /tmp/stub/lolcat /tmp/stub/fastfetch /tmp/stub-cow/
    want="COW
LOL
BYE"
    export PATH=/tmp/stub:$PATH
    [ -z "$(zsh -lc true)" ]
    got=$(zsh -lic true 2>/dev/null)
    [ -z "$got" ] || { echo "== zsh -lic with a command printed: $got" >&2; exit 1; }
    got=$(echo true | zsh -li 2>/dev/null)
    [ "$got" = "$want" ] || { echo "== zsh -li printed: $got" >&2; exit 1; }
    # cowsay without fortune and lolcat without figlet: no banner, only the goodbye
    PATH=/tmp/stub-cow:${PATH#/tmp/stub:}
    got=$(echo true | zsh -li 2>/dev/null)
    [ "$got" = BYE ] || { echo "== banner without its tools: $got" >&2; exit 1; }
'
ok login banner stays out of command output

# doctor's Ubuntu check, login shell and (for a selected module) the checks that its hooks cannot make: each
# broken on purpose, and mended again, in one container
docker run --rm "$image" zsh -lc "$doctor_lib"'
    # /etc/os-release is a link to this file
    os=/usr/lib/os-release
    sudo cp $os /tmp/os-release.orig
    step VERSION_ID is not 26.04
    sudo sed -i "s/^VERSION_ID=.*/VERSION_ID=\"24.04\"/" $os
    doctor_says FAIL ubuntu
    sudo cp /tmp/os-release.orig $os
    step ID is not ubuntu
    sudo sed -i "s/^ID=.*/ID=debian/" $os
    doctor_says FAIL ubuntu
    sudo cp /tmp/os-release.orig $os
    doctor_says ok ubuntu

    step login shell is not zsh
    sudo usermod -s /bin/bash "$(id -un)"
    doctor_says FAIL login-shell
    sudo usermod -s /usr/bin/zsh "$(id -un)"
    doctor_says ok login-shell
'
ok doctor rejects another Ubuntu release and another login shell

# server: the hook doctor shares with `djd apply`, on the stock sshd_config layout and on the layouts that need
# sshd -T. Ubuntu runs sshd -T through sudo, whose secure_path holds /usr/local/sbin, so a stub there stands in.
docker run --rm "$image" zsh -lc "$doctor_lib"'
    printf "env = [\"agent\", \"server\"]\n" >~/.dotfiles/mise-config/miserc.local.toml
    # a real sshd evaluates Match blocks only under -C; a hook that leaves it out sees the global value
    sshd_t() {
        sudo tee /usr/local/sbin/sshd >/dev/null <<EOF
#!/bin/sh
pw=$1
case " \$* " in *" -C "*) grep -qiE "^[[:space:]]*Match all" /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf && pw=yes ;; esac
echo passwordauthentication \$pw
echo kbdinteractiveauthentication no
echo permitrootlogin no
EOF
        sudo chmod +x /usr/local/sbin/sshd
    }
    sudo install -d /etc/ssh/sshd_config.d
    sudo touch /etc/ssh/sshd_config.d/10-djd.conf
    printf "Include /etc/ssh/sshd_config.d/*.conf\n" | sudo tee /etc/ssh/sshd_config >/dev/null
    step stock layout
    doctor_says ok sshd
    # the counter-case: the stock layout needs no sshd -T, so a stub that reports passwords on is never asked
    step stock layout, stub reporting passwords on
    sshd_t yes
    doctor_says ok sshd
    # without the keys-only drop-in the greps have nothing to vouch for, so sshd -T decides (the stub still says yes)
    step the stock layout without the keys-only drop-in
    sudo rm /etc/ssh/sshd_config.d/10-djd.conf
    doctor_says FAIL sshd "not keys-only"
    sshd_t no
    doctor_says ok sshd
    sudo touch /etc/ssh/sshd_config.d/10-djd.conf
    # the server module is selected but was never applied in this image, so bootstrap is not converged
    doctor_says FAIL bootstrap "not converged"

    step a Match all block that turns passwords on
    sshd_t no
    printf "Match all\nPasswordAuthentication yes\n" | sudo tee /etc/ssh/sshd_config.d/99-m.conf >/dev/null
    doctor_says FAIL sshd "not keys-only"
    step a Match block that leaves the three settings alone
    printf "Match User nobody\nX11Forwarding no\n" | sudo tee /etc/ssh/sshd_config.d/99-m.conf >/dev/null
    doctor_says ok sshd
    sudo rm /etc/ssh/sshd_config.d/99-m.conf

    step an earlier drop-in that turns passwords on
    sudo touch /etc/ssh/sshd_config.d/00-x.conf
    sshd_t yes
    doctor_says FAIL sshd "not keys-only"
    step an earlier drop-in that changes nothing
    sshd_t no
    doctor_says ok sshd

    step an sshd_config that does not start with the Include
    sudo rm /etc/ssh/sshd_config.d/00-x.conf
    printf "PasswordAuthentication yes\n" | sudo tee /etc/ssh/sshd_config >/dev/null
    sshd_t yes
    doctor_says FAIL sshd "not keys-only"
    sshd_t no
    doctor_says ok sshd

    # settings the greps cannot see force sshd -T: an Include inside a drop-in, and a drop-in this user cannot read
    # (cloud-init writes 50-cloud-init.conf with mode 0600). Each is a FAIL only when sshd -T says passwords are on.
    printf "Include /etc/ssh/sshd_config.d/*.conf\n" | sudo tee /etc/ssh/sshd_config >/dev/null
    step a drop-in with an Include
    printf "Include /etc/ssh/extra.conf\n" | sudo tee /etc/ssh/sshd_config.d/99-i.conf >/dev/null
    sshd_t yes
    doctor_says FAIL sshd "not keys-only"
    sshd_t no
    doctor_says ok sshd
    sudo rm /etc/ssh/sshd_config.d/99-i.conf
    step a drop-in this user cannot read
    sudo install -m 0600 /dev/null /etc/ssh/sshd_config.d/50-cloud-init.conf
    sshd_t yes
    doctor_says FAIL sshd "not keys-only"
    sshd_t no
    doctor_says ok sshd
'
ok doctor checks sshd only through the hook it shares with apply

# the mise config dir must be the checkout's mise-config. The script runs directly: with another XDG_CONFIG_HOME
# `djd doctor` would not find its own task.
docker run --rm "$image" zsh -lc "$doctor_lib"'
    step the mise config link points elsewhere
    rc=0
    out=$(XDG_CONFIG_HOME=/tmp/elsewhere bash ~/.dotfiles/mise-config/tasks/djd/doctor 2>&1) || rc=$?
    grep -q "^FAIL mise-config" <<<"$out" || { echo "$out" >&2; exit 1; }
    [ "$rc" != 0 ]
'
ok doctor checks the mise config link

# the sheldon lock: missing, older than the config, or naming a directory that is gone
docker run --rm "$image" zsh -lc "$doctor_lib"'
    lock=~/.local/share/sheldon/plugins.lock
    config=~/.config/sheldon/plugins.toml
    doctor_says ok plugins
    step a config newer than its lock
    touch "$config"
    doctor_says FAIL plugins "newer than its lock"
    touch "$lock"
    doctor_says ok plugins
    step a plugin directory that is gone
    rm -rf ~/.local/share/sheldon/repos/github.com/romkatv
    doctor_says FAIL plugins "a plugin directory is missing"
    step no lock at all
    rm -f "$lock"
    doctor_says FAIL plugins "no sheldon lock"
'
ok doctor checks the sheldon lock

# each xrdp setting has its own line, and a commented-out default is not the setting
docker run --rm "$image" zsh -lc "$doctor_lib"'
    sudo install -d /etc/xrdp
    xrdp() { printf "%s\n" "[Globals]" "$1" | sudo tee /etc/xrdp/xrdp.ini >/dev/null; }
    sesman() { printf "%s\n" "[Security]" "$1" | sudo tee /etc/xrdp/sesman.ini >/dev/null; }
    xrdp security_layer=tls
    sesman AllowRootLogin=false
    doctor_says ok xrdp-tls
    doctor_says ok xrdp-root-login

    step security_layer=negotiate
    xrdp security_layer=negotiate
    doctor_says FAIL xrdp-tls
    doctor_says ok xrdp-root-login
    step security_layer only as a comment
    xrdp "#security_layer=tls"
    doctor_says FAIL xrdp-tls
    xrdp security_layer=tls
    step AllowRootLogin=true
    sesman AllowRootLogin=true
    doctor_says FAIL xrdp-root-login
    doctor_says ok xrdp-tls
'
ok doctor checks xrdp TLS and root login separately

# One container: a conflicting real file shows up in doctor, stays put on `djd apply --dry-run`, and is moved
# aside by a real apply; a checkout that moved (the `make init` path) is linked back by install.sh, the init
# caches are gone after the apply, and the machine converges afterwards. plan covers packages, files, services
# and the firewall; doctor adds the Ubuntu release, the mise link, the login shell and the dotfiles.
docker run --rm -e MISE_GITHUB_TOKEN "$image" zsh -lc "$doctor_lib"'
    # before ~/.bashrc is replaced, because bash fills its cache from that file
    step warm the init caches
    zsh -ic true >/dev/null 2>&1
    bash -ic true >/dev/null 2>&1
    [ -n "$(ls -A ~/.cache/zsh/init)" ]
    [ -n "$(ls -A ~/.cache/bash/init)" ]
    rm ~/.bashrc && echo custom >~/.bashrc
    [ -z "$(find ~ -maxdepth 1 -name "*.djd-backup-*")" ]
    # the indent, because the table that a failed bootstrap check prints also names ~/.bashrc
    step doctor lists the drifted dotfile
    doctor_says FAIL dotfiles "^  .*\.bashrc"

    # the exit status is not the contract: mise itself reports the refusal to overwrite the file on a dry run
    step a dry run moves nothing
    djd apply --dry-run >/dev/null 2>&1 || true
    [ -f ~/.bashrc ]
    [ ! -L ~/.bashrc ]
    grep -qx custom ~/.bashrc
    [ -z "$(find ~ -maxdepth 1 -name "*.djd-backup-*")" ]

    # ~/.dotfiles is a link to the checkout, as `make init` leaves it, and the checkout then moves: the link
    # dangles, which install.sh has to remove before it can link the checkout again
    mv ~/.dotfiles ~/src
    ln -s ~/src ~/.dotfiles
    mv ~/src ~/src2
    [ -L ~/.dotfiles ]
    [ ! -e ~/.dotfiles ]
    step install.sh on the moved checkout
    ~/src2/install.sh
    [ "$(readlink ~/.dotfiles)" = "$HOME/src2" ]
    test -L ~/.bashrc
    grep -q custom ~/.bashrc.djd-backup-*
    step apply clears the init caches
    [ -z "$(ls -A ~/.cache/zsh/init ~/.cache/bash/init 2>/dev/null)" ]
    step converged
    djd doctor
    mise bootstrap plan --detailed-exitcode
'
ok conflicting file backed up, moved checkout relinked, re-apply converges

# a directory link into the checkout is no conflict: the files seen through it are the repo's own, and moving one
# aside would rename a tracked file. The hook runs on its own, because a real apply would not get past the link.
docker run --rm "$image" zsh -lc '
    set -e
    rm -rf ~/.config/lsd
    ln -s ~/.dotfiles/home/.config/lsd ~/.config/lsd
    # two lines: under set -e only the last command of an && list can fail the script
    [ -f ~/.config/lsd/config.yaml ]
    [ ! -L ~/.config/lsd/config.yaml ]
    ~/.dotfiles/mise-config/hooks/dotfile-conflicts home
    [ -f ~/.dotfiles/home/.config/lsd/config.yaml ]
    [ -z "$(find ~/.dotfiles/home ~/.config -name "*.djd-backup-*")" ]
'
ok a directory link into the checkout is not moved aside

# the revision comes from the image, which has no .git
docker run --rm "$image" zsh -lc '
    set -e
    [ -n "$DJD_REVISION" ]
    out=$(djd status)
    grep -qx "checkout: .* @ $DJD_REVISION" <<<"$out"
'
ok djd status prints the revision

# install.sh replaces a mise older than the min_version it reads. A stub curl hands `sh` a script that only records
# MISE_VERSION, and a stub mise stands in for the old one; the control is the image's real mise, which must not be
# reinstalled, and install.sh's own apply then has to succeed (it ends in `exec djd apply`).
docker run --rm "$image" bash -c '
    set -e
    min=$(sed -n "s/^min_version = \"\(.*\)\"$/\1/p" ~/.dotfiles/mise-config/config.toml)
    [ -n "$min" ]
    mkdir ~/stub
    # install.sh saves the download with `curl ... -o FILE URL` before it runs it; without -o the script goes to stdout
    cat >~/stub/curl <<"EOF"
#!/bin/sh
out=/dev/stdout
while [ $# -gt 0 ]; do
    [ "$1" != -o ] || out=$2
    shift
done
echo "echo version=\$MISE_VERSION >>\$HOME/install.log" >"$out"
EOF
    chmod +x ~/stub/curl
    export PATH=~/stub:$PATH
    # control: the real mise is new enough, so nothing is downloaded
    ~/.dotfiles/install.sh >/tmp/install.out 2>&1 || { cat /tmp/install.out >&2; exit 1; }
    [ ! -e ~/install.log ]
    mv ~/.local/bin/mise ~/.local/bin/mise.real
    printf "#!/bin/sh\necho 2000.1.1 linux-x64\n" >~/.local/bin/mise
    chmod +x ~/.local/bin/mise
    # the stub leaves the old mise in place, so install.sh dies on its version check right after the stub download.
    # That is the end the runs below expect, and the message shows it was this check and not an earlier failure.
    stale() {
        "$@" >/tmp/install.out 2>&1 || true
        grep -q "installing mise failed" /tmp/install.out || { cat /tmp/install.out >&2; return 1; }
    }
    stale ~/.dotfiles/install.sh
    grep -qx "version=v$min" ~/install.log
    # an override names the same release with or without the v
    rm ~/install.log
    MISE_VERSION=2099.1.1 stale ~/.dotfiles/install.sh
    grep -qx "version=v2099.1.1" ~/install.log
    rm ~/install.log
    MISE_VERSION=v2099.1.1 stale ~/.dotfiles/install.sh
    grep -qx "version=v2099.1.1" ~/install.log
'
ok install.sh replaces a mise older than min_version

# the age key, an encrypted value, and the value coming back through the secrets module. age.strict is off, so
# a broken decrypt would otherwise just leave the variable unset
docker run --rm -e MISE_GITHUB_TOKEN "$image" zsh -lc "$doctor_lib"'
    step keygen
    djd secret keygen >/dev/null
    [ "$(stat -c %a ~/.config/djd/age.txt)" = 600 ]
    [ "$(stat -c %a ~/.config/djd)" = 700 ]
    # a pipeline that starts with ! is exempt from set -e, so the refusals are spelled out
    key_before=$(cat ~/.config/djd/age.txt)
    if djd secret keygen >/dev/null 2>&1; then exit 1; fi
    [ "$(cat ~/.config/djd/age.txt)" = "$key_before" ]
    step secret set
    # the first set runs with the module unselected, the usual case: the task itself has to pass the key and the
    # experimental flag, or mise cannot encrypt
    printf "s3cret\n" | djd secret set DJD_CHECK >/dev/null
    grep -q DJD_CHECK ~/.dotfiles/mise-config/config.secrets.toml
    if grep -q s3cret ~/.dotfiles/mise-config/config.secrets.toml; then exit 1; fi
    # the module is selected before the second set: with values to redact in the environment, mise stops feeding
    # stdin to a task that is not raw, so the second set stored an empty value and exited 0
    printf "env = [\"agent\", \"secrets\"]\n" >~/.dotfiles/mise-config/miserc.local.toml
    printf "second\n" | djd secret set DJD_CHECK2 >/dev/null
    # NAME=value would put the plaintext in argv; exit 2 is the usage error
    rc=0
    printf "x\n" | djd secret set DJD_BAD=plain >/dev/null 2>&1 || rc=$?
    [ "$rc" = 2 ]
    if grep -q DJD_BAD ~/.dotfiles/mise-config/config.secrets.toml; then exit 1; fi
    [ "$(mise exec -- printenv DJD_CHECK)" = s3cret ]
    [ "$(mise exec -- printenv DJD_CHECK2)" = second ]
    doctor_says ok secrets

    step missing key
    mv ~/.config/djd/age.txt ~/age.bak
    doctor_says FAIL secrets "no age key"
    step a different key
    djd secret keygen >/dev/null
    doctor_says FAIL secrets "does not decrypt"
    # the right key again, so that only its mode can make doctor fail from here on
    mv ~/age.bak ~/.config/djd/age.txt
    doctor_says ok secrets
    for mode in 640 604 644; do
        step key mode $mode
        chmod $mode ~/.config/djd/age.txt
        doctor_says FAIL secrets "must not be accessible"
    done
    for mode in 400 600; do
        step key mode $mode
        chmod $mode ~/.config/djd/age.txt
        doctor_says ok secrets
    done
'
ok secrets round trip, and doctor rejects a missing key, a different key and a key open to group or others
