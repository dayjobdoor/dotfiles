#!/usr/bin/env bash
#MISE description="Fresh Ubuntu VM (incus or multipass): curl | sh install of the base, server and warp, hardening, module removal"
# cloud-init, the README's `curl | sh -s -- server` plus the warp module (cloning this tree instead of GitHub), then
# tests/vm-checks.sh inside the VM. Uses the first of incus (CI, Linux) and multipass found.
# GITHUB_TOKEN, if set, is handed to mise in the VM. DJD_KEEP_VM=1 (exactly 1) keeps the VM after the run, to inspect a failure.
# -E: the ERR trap also fires inside vm_create and vm_sh
set -Eeuo pipefail
# GitHub lists ::error:: lines as annotations, which `gh run view` shows without the log
# shellcheck disable=SC2329 # invoked by the ERR trap
on_err() {
    echo "FAIL line $1: $2" >&2
    [ -z "${GITHUB_ACTIONS:-}" ] || printf '::error::test:vm line %s: %.300s\n' "$1" "${2//$'\n'/ }"
}
trap 'on_err "$LINENO" "$BASH_COMMAND"' ERR

cd "$(dirname "$0")/../../.."
# $$ alone repeats when a PID is reused; $RANDOM makes a leftover from an earlier run unlikely to collide
name="djd-test-$$-$RANDOM"

# cloud-init gets 15 minutes (a hung first boot would otherwise stall until the CI job limit). The timeout runs
# inside the VM, so it needs no timeout command on the host. `status --wait` exits non-zero when cloud-init failed,
# and its long status says why. Each backend defines vm_root, which runs a command as root in the VM.
cloud_init_wait() {
    local rc=0
    # through a pipe, not `>/dev/null`: multipass exec on macOS spins at 100% CPU forever when its output goes to /dev/null
    vm_root timeout 900 cloud-init status --wait | cat >/dev/null || rc=$?
    if [ "$rc" -ne 0 ]; then
        if [ "$rc" -eq 124 ]; then
            echo "vm: cloud-init did not finish within 900 s" >&2
        else
            echo "vm: cloud-init failed (exit $rc)" >&2
        fi
        vm_root cloud-init status --long >&2 || true
        exit 1
    fi
}

# cloud-init/vm.yaml above its "djd-install-below" marker: the part that sets the machine up. Below it are the owner's
# SSH key and the install from GitHub, which this test replaces with its own checkout and no key.
userdata() { sed '/^# djd-install-below$/,$d' cloud-init/vm.yaml; }
# without the marker sed would pass the whole file on, and the VM would run the real install from GitHub main
grep -qx '# djd-install-below' cloud-init/vm.yaml || {
    echo "vm: cloud-init/vm.yaml has no '# djd-install-below' line" >&2
    exit 2
}

if command -v incus >/dev/null 2>&1; then
    vm_create() {
        # nesting lets docker (server module) run inside the system container
        incus launch images:ubuntu/26.04/cloud "$name" -c security.nesting=true \
            -c cloud-init.user-data="$(userdata)" >/dev/null
        cloud_init_wait
    }
    vm_root() { incus exec "$name" -- "$@"; }
    vm_sh() { incus exec "$name" -- sudo -iu dayjobdoor bash -c "$1"; }
    vm_delete() { incus delete -f "$name" >/dev/null 2>&1 || true; }
elif command -v multipass >/dev/null 2>&1; then
    vm_create() {
        # the defaults (1 CPU, 1 GB RAM, 5 GB disk) cannot hold the desktop. --timeout: seconds that
        # multipass waits for the launch itself; 900 gives it the same 15 minutes as the cloud-init wait
        userdata | multipass launch 26.04 --name "$name" --cpus 4 --memory 8G --disk 40G --timeout 900 \
            --cloud-init - >/dev/null
        cloud_init_wait
    }
    vm_root() { multipass exec "$name" -- sudo "$@"; }
    # multipass exec arrives over ssh, and mise refuses to set the firewall to default deny for a process that came in
    # over ssh without SSH_CONNECTION, which `sudo -i` would drop
    vm_sh() { multipass exec "$name" -- sudo --preserve-env=SSH_CONNECTION -iu dayjobdoor bash -c "$1"; }
    vm_delete() { multipass delete --purge "$name" >/dev/null 2>&1 || true; }
else
    echo "vm: needs incus or multipass" >&2
    exit 2
fi

trap '[ "${DJD_KEEP_VM:-}" = 1 ] || vm_delete' EXIT
vm_create
echo "vm: $name is up"

# the token travels on stdin into a 0600 file, never through argv
printf '%s' "${GITHUB_TOKEN:-}" | vm_sh 'umask 077 && cat >~/.djd-github-token'
# tracked and unignored files only: no .env, age.txt or miserc.local.toml (which would change the VM's modules)
tests/tree.sh | vm_sh 'mkdir -p ~/djd-src && tar -xf - -C ~/djd-src'
vm_sh 'git -c init.defaultBranch=main init -q ~/djd-src && cd ~/djd-src && git add -A &&
    git -c user.name=djd -c user.email=djd@localhost commit -qm test'

# single quotes on purpose: these expand inside the VM. install.sh arrives on stdin as from curl, so it clones.
# DJD_SKIP_SSH_CHECKS: the VM has no authorized key (it is reached through incus or multipass), and the server
# module's post-packages hook refuses to turn passwords off for a user who has none. vm-checks.sh applies again, so
# it needs the variable too.
# shellcheck disable=SC2016
vm_sh 'MISE_GITHUB_TOKEN=$(cat ~/.djd-github-token) DJD_SKIP_SSH_CHECKS=1 DJD_REPO="file://$HOME/djd-src" sh -s -- server warp <~/djd-src/install.sh'
# DJD_TEST_VM: vm-checks.sh refuses to run anywhere else. GITHUB_ACTIONS reaches the VM so that its failures annotate
# too; %q quotes it for the shell inside the VM.
gha=$(printf '%q' "${GITHUB_ACTIONS:-}")
# shellcheck disable=SC2016
vm_sh 'MISE_GITHUB_TOKEN=$(cat ~/.djd-github-token) DJD_SKIP_SSH_CHECKS=1 DJD_TEST_VM=1 GITHUB_ACTIONS='"$gha"' bash ~/.dotfiles/tests/vm-checks.sh'
echo "vm: ok"
