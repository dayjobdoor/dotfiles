#!/usr/bin/env bash
#MISE description="Converge this machine to the selected modules (packages, files, services, firewall, dotfiles, tools)"
#MISE quiet=true
set -euo pipefail

# Real files that a dotfile would replace are moved aside by the pre-dotfiles hook (hooks/dotfile-conflicts), so that
# they stay put on --dry-run, --skip dotfiles and a bootstrap that fails before the dotfiles part.
# DJD_BOOTSTRAP_FLAGS: extra mise bootstrap flags for non-interactive callers (the Docker build's passes)
status=0
# shellcheck disable=SC2086
mise bootstrap --yes --update ${DJD_BOOTSTRAP_FLAGS:-} "$@" || status=$?
# after bootstrap, so a cache that a shell started mid-run wrote is removed too (home/.config/zsh/.zshrc, home/.bashrc)
rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}"/zsh/init "${XDG_CACHE_HOME:-$HOME/.cache}"/bash/init
exit "$status"
