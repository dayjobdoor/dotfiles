#!/usr/bin/env bash
#MISE description="Create the age key or encrypt a value into the secrets module"
#MISE quiet=true
#USAGE arg "<action>" { choices "keygen" "set"; }
#USAGE arg "[name]" help="Variable to encrypt with set, such as GITHUB_TOKEN; the value is prompted"
set -euo pipefail
# fixed: mise loads config.secrets.toml from ~/.config/mise, a link into ~/.dotfiles
DJD_DIR="$HOME/.dotfiles"
# must match age.key_file in config.secrets.toml
key="$HOME/.config/djd/age.txt"
name=${usage_name:-}

case ${usage_action?} in
keygen)
    if [ -e "$key" ]; then
        echo "djd: $key exists; refusing to overwrite it" >&2
        exit 1
    fi
    mkdir -p "${key%/*}"
    chmod 700 "${key%/*}"
    (umask 077 && mise x age@latest -- age-keygen -o "$key")
    echo "djd: back up $key outside this machine; every machine that reads the secrets needs a copy"
    ;;
set)
    # a name only: NAME=value would put the plaintext in argv and shell history
    if [[ ! $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
        echo "djd: usage: djd secret set NAME (letters, digits and _; the value is prompted)" >&2
        exit 2
    fi
    if [ ! -r "$key" ]; then
        echo "djd: no key at $key; run djd secret keygen, or copy the key from another machine" >&2
        exit 1
    fi
    # the module is usually unselected here, so its settings are not loaded: pass the key and the experimental flag
    MISE_EXPERIMENTAL=1 exec mise set --file "$DJD_DIR/mise-config/config.secrets.toml" --age-encrypt --age-key-file "$key" --prompt "$name"
    ;;
esac
