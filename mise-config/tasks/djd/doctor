#!/usr/bin/env bash
#MISE description="Check this machine against the repo; exit 1 on any failure"
#MISE quiet=true
set -euo pipefail
# fixed: mise reads ~/.config/mise (a link into this checkout) and dotfiles.root, which defaults to ~/.dotfiles
DJD_DIR="$HOME/.dotfiles"

failed=0
ok() { echo "ok $1"; }
fail() {
    echo "FAIL $1: $2"
    failed=1
}
selected() { [[ ,${MISE_ENV:-}, == *,"$1",* ]]; }

# the same test as install.sh
if (. /etc/os-release && [ "${ID:-}" = ubuntu ] && [ "${VERSION_ID:-}" = 26.04 ]); then ok ubuntu; else fail ubuntu "/etc/os-release is not Ubuntu 26.04"; fi

have=$(readlink -f "${XDG_CONFIG_HOME:-$HOME/.config}/mise" || true)
want=$(readlink -f "$DJD_DIR/mise-config")
if [ "$have" = "$want" ]; then ok mise-config; else fail mise-config "mise config dir is ${have:-missing}, want $want"; fi

shell=$(getent passwd "$(id -un)" | cut -d: -f7)
case $shell in
*/zsh) ok login-shell ;;
*) fail login-shell "$shell is not zsh" ;;
esac

if out=$(mise bootstrap status --missing 2>&1); then ok bootstrap; else
    fail bootstrap "not converged; run djd apply"
    printf '%s\n' "$out"
fi
# --json, because the plain output also reports history capture, which this repository does not use
if out=$(mise dot status --missing --json 2>/dev/null); then ok dotfiles; else
    fail dotfiles "not deployed; run djd apply, which moves a file that a program rewrote aside as *.djd-backup-<time>, or mise dot add <path> to keep the edit"
    jq -r '.files[] | select(.state != "applied") | "  \(.state): \(.reason // .source)"' <<<"$out" 2>/dev/null ||
        mise dot status --missing 2>&1 || true
fi

# the zsh plugins: sheldon's lock file has to exist, be newer than the config that names the plugins, and point at
# directories that are there. `sheldon source` would fetch on a stale lock, and a doctor changes nothing.
config="${XDG_CONFIG_HOME:-$HOME/.config}/sheldon/plugins.toml"
lock="${XDG_DATA_HOME:-$HOME/.local/share}/sheldon/plugins.lock"
if [ ! -s "$lock" ]; then
    fail plugins "no sheldon lock at $lock; run djd apply"
elif [ "$config" -nt "$lock" ]; then
    fail plugins "$config is newer than its lock; run djd apply"
elif missing=$(sed -nE 's/^source_dir = "(.*)"$/\1/p' "$lock" | while read -r dir; do [ -d "$dir" ] || echo "$dir"; done) && [ -n "$missing" ]; then
    fail plugins "a plugin directory is missing: $(head -n1 <<<"$missing"); run djd apply"
else
    ok plugins
fi

# bootstrap status cannot see what the hooks enforce: they run on every apply and are imperative
if selected server; then
    if out=$("$DJD_DIR/mise-config/hooks/sshd-keys-only" 2>&1); then ok sshd; else fail sshd "${out#djd server: }"; fi
fi
# every machine has xrdp: the desktop is part of the base
{
    if grep -qx security_layer=tls /etc/xrdp/xrdp.ini; then ok xrdp-tls; else fail xrdp-tls "/etc/xrdp/xrdp.ini lacks security_layer=tls; run djd apply"; fi
    if grep -qx AllowRootLogin=false /etc/xrdp/sesman.ini; then ok xrdp-root-login; else fail xrdp-root-login "/etc/xrdp/sesman.ini lacks AllowRootLogin=false; run djd apply"; fi
}

# age.strict is off in the secrets module, so a missing or wrong key would leave its variables unset without a word
if selected secrets; then
    key="$HOME/.config/djd/age.txt"
    if [ ! -r "$key" ]; then
        fail secrets "no age key at $key; copy it from another machine"
    elif ((8#$(stat -c %a "$key") & 8#077)); then
        fail secrets "$key is mode $(stat -c %a "$key"); it must not be accessible to group or others (chmod 600)"
    elif MISE_AGE_STRICT=true mise env >/dev/null 2>&1; then
        ok secrets
    else
        fail secrets "a value does not decrypt with $key"
    fi
fi

exit "$failed"
