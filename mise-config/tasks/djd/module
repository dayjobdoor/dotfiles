#!/usr/bin/env bash
#MISE description="List, add or remove machine modules"
#MISE quiet=true
#USAGE arg "<action>" { choices "list" "add" "remove"; }
#USAGE arg "[module]..." var=#true help="Modules to add or remove" {
#USAGE   choices "agent" "server" "desktop" "full" "secrets"
#USAGE }
set -euo pipefail
# fixed: mise reads miserc.local.toml from ~/.config/mise, a link into this checkout
DJD_DIR="$HOME/.dotfiles"

# the canonical order, so later modules win key collisions
order=(agent server desktop full secrets)
modules=()
# usage hands variadic args over as one shell-quoted string; its choices limit the words to known modules, and the
# loop below refuses any other word, so the names are safe as array subscripts
read -ra modules <<<"${usage_module:-}"
declare -A on=()
IFS=, read -r -a current <<<"${MISE_ENV:-}"
for m in "${current[@]}"; do
    # an empty item (MISE_ENV=a,,b) is no module, and an empty array subscript is an error
    [ -z "$m" ] || on[$m]=1
done

write_selection() {
    local m list=""
    for m in "${order[@]}"; do
        if [ -n "${on[$m]:-}" ]; then list="${list:+$list, }\"$m\""; fi
    done
    local file="$DJD_DIR/mise-config/miserc.local.toml"
    if [ -z "$list" ]; then rm -f "$file"; else printf 'env = [%s]\n' "$list" >"$file"; fi
}

action=${usage_action?}
for m in "${modules[@]}"; do
    case " ${order[*]} " in
    *" $m "*) ;;
    *)
        echo "djd: unknown module $m; the modules are: ${order[*]}" >&2
        exit 2
        ;;
    esac
done
if [ "$action" != list ] && [ ${#modules[@]} -eq 0 ]; then
    echo "djd: name at least one module to $action: ${order[*]}" >&2
    exit 2
fi
case $action in
list)
    for m in "${order[@]}"; do
        if [ -n "${on[$m]:-}" ]; then echo "$m selected"; else echo "$m -"; fi
    done
    ;;
add)
    for m in "${modules[@]}"; do on[$m]=1; done
    # npm: tools in full need bun from agent
    if [ -n "${on[full]:-}" ]; then on[agent]=1; fi
    # config.secrets.toml: everything that runs on the machine sees the decrypted values, and agent runs agents. A
    # personal workstation may want both, so this warns and does not refuse
    if [ -n "${on[secrets]:-}" ] && [ -n "${on[agent]:-}" ]; then
        echo "djd: secrets and agent are both selected: every agent tool on this machine sees the decrypted values. Keep this combination off sandboxes" >&2
    fi
    # the firewall rules for 3389/tcp live in the server module
    if [ -n "${on[desktop]:-}" ] && [ -z "${on[server]:-}" ]; then
        echo "djd: desktop without server leaves RDP (3389/tcp) open on every interface; the server module adds the firewall rules" >&2
    fi
    write_selection
    # MISE_ENV inherited from this task outranks miserc.local.toml
    unset MISE_ENV
    exec mise run djd:apply
    ;;
remove)
    removed=()
    brave=/etc/apt/sources.list.d/mise-brave-browser.sources
    for m in "${modules[@]}"; do
        # the selection is written before the unapply below, so a run that failed halfway leaves the module
        # unselected but its files in place; a retry has to unapply them
        if [ -z "${on[$m]:-}" ]; then echo "djd: $m is not selected; unapplying anything it left behind" >&2; fi
        unset "on[$m]"
        removed+=("$m")
    done
    if [ -n "${on[full]:-}" ] && [ -z "${on[agent]:-}" ]; then
        echo "djd: full requires agent; remove full first" >&2
        exit 2
    fi
    write_selection
    unset MISE_ENV
    for m in "${removed[@]}"; do
        mise bootstrap unapply "$m" --yes
        if [ -d "$DJD_DIR/$m" ]; then
            # mise reports a group that was never applied as an error
            if out=$(mise dot unapply --group "$m" --yes 2>&1); then
                [ -z "$out" ] || printf '%s\n' "$out"
            elif [[ $out == *"has no recorded files"* ]]; then
                echo "djd: $m has no deployed dotfiles"
            else
                printf '%s\n' "$out" >&2
                exit 1
            fi
        fi
        # mise never removes an apt source it added; left behind, the repository would stay trusted and feed apt upgrade
        if [ "$m" = desktop ] && [ -e "$brave" ]; then
            sudo rm -f "$brave"
            echo "djd: removed Brave's apt source"
        fi
        if [ "$m" = server ]; then
            # the unapply deletes the sshd drop-in and daemon.json and leaves the firewall rules (tests/vm-checks.sh
            # asserts both); say what that means before the session that ran this is lost
            echo "djd: server removed: sshd may accept passwords again and docker may publish ports on every address again. The firewall stays enabled with its rules (SSH included). Check 'sudo sshd -T | grep -i passwordauth' before you log out" >&2
        fi
        echo "djd: packages installed by $m stay; remove them with apt if needed"
    done
    # converge what the remaining modules still declare (e.g. the base locale over desktop's)
    exec mise run djd:apply
    ;;
esac
