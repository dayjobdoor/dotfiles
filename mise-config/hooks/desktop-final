#!/usr/bin/env bash
# The desktop module's final hook (declared in config.desktop.toml).
set -euo pipefail

# Screen lockers blank xrdp sessions and im-config breaks xrdp logins. An install from before PipeWire got the
# pulseaudio daemon through xfce4-pulseaudio-plugin, and apt keeps it next to pipewire-pulse: both would claim
# the pulse socket.
for p in light-locker xscreensaver im-config pulseaudio; do
    if dpkg -s "$p" >/dev/null 2>&1; then sudo apt-get purge -y "$p"; fi
done

# Refuse the weak xrdp settings: "negotiate" lets a client fall back to the RDP security layer, and sesman allows
# root logins. Every run reasserts them. A restart is left to the user: it ends the RDP session an apply may run over.
restart=
set_ini() {
    if grep -qx "$2=$3" "$1"; then return; fi
    sudo sed -i "s/^$2=.*/$2=$3/" "$1"
    if ! grep -qx "$2=$3" "$1"; then
        echo "desktop-final: $1 has no $2= line to set" >&2
        exit 1
    fi
    restart=1
}
set_ini /etc/xrdp/xrdp.ini security_layer tls
set_ini /etc/xrdp/sesman.ini AllowRootLogin false
if [ -n "$restart" ]; then echo "desktop-final: xrdp needs a restart to pick up security_layer=tls and AllowRootLogin=false"; fi

# HackGen NF, the terminal font in DESIGN.md, has no Ubuntu package. Bump both values together.
version=v2.10.0
sha256=f8abd483d5edfad88a78ed511978f43c83b43c48e364aa29ebe4a68217474428
dir="${XDG_DATA_HOME:-$HOME/.local/share}/fonts/HackGen"
if [ "$(cat "$dir/.version" 2>/dev/null)" != "$version" ]; then
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    curl -fsSL -o "$tmp/hackgen.zip" "https://github.com/yuru7/HackGen/releases/download/$version/HackGen_NF_$version.zip"
    echo "$sha256  $tmp/hackgen.zip" | sha256sum -c --quiet -
    unzip -q -j "$tmp/hackgen.zip" '*.ttf' -d "$tmp/ttf"
    rm -rf "$dir"
    mkdir -p "$dir"
    mv "$tmp"/ttf/*.ttf "$dir"/
    echo "$version" >"$dir/.version"
    fc-cache -f "$dir" >/dev/null
fi
