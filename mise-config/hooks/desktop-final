#!/usr/bin/env bash
# The base's final hook (declared in config.toml, phase `final`, after the tools): purges the
# packages that break xrdp sessions, lets the user capture with Wireshark, read the touchpad and run the Electron
# apps with their sandbox, and pins the xrdp security settings. It downloads nothing, because the Docker
# build runs it in its first RUN, which has no GitHub token (the tools phase gets one in the second). Every run
# must be safe to repeat.
set -euo pipefail

# Screen lockers blank xrdp sessions and im-config breaks xrdp logins. A pulseaudio daemon next to pipewire-pulse
# means two servers claim the pulse socket (xfce4-pulseaudio-plugin can pull it in).
for p in light-locker xscreensaver im-config pulseaudio; do
    if dpkg -s "$p" >/dev/null 2>&1; then sudo apt-get purge -y -o DPkg::Lock::Timeout=120 "$p"; fi
done

# Wireshark: its debconf question install-setuid defaults to no, which leaves capture to root. Answering yes and
# reconfiguring makes dumpcap capture for the group wireshark, and the user joins that group (a new login applies it).
if dpkg -s wireshark-common >/dev/null 2>&1; then
    echo 'wireshark-common wireshark-common/install-setuid boolean true' | sudo debconf-set-selections
    sudo DEBIAN_FRONTEND=noninteractive dpkg-reconfigure wireshark-common
    if getent group wireshark >/dev/null; then sudo usermod -aG wireshark "$(id -un)"; fi
fi

# fusuma reads the touchpad through libinput, which needs the group input.
sudo usermod -aG input "$(id -un)"

# Electron's sandbox (Obsidian, Ferdium) needs unprivileged user namespaces, which Ubuntu's AppArmor denies to a program
# without a profile. /etc/apparmor.d/djd-electron (config.toml) allows them for those two programs. Where
# AppArmor cannot be loaded (a container), the profile stays unloaded.
if command -v apparmor_parser >/dev/null && sudo test -w /sys/kernel/security/apparmor/.replace; then
    sudo apparmor_parser -r /etc/apparmor.d/djd-electron
fi

# Refuse the weak xrdp settings: "negotiate" lets a client fall back to the RDP security layer, and sesman allows
# root logins. Every run reasserts them. The daemon that the xrdp package started keeps the settings it read, so a
# running one is restarted once per change (the stamp), unless an RDP session is open: a restart would end the
# session an apply may be running over, and the next apply tries again.
changed=
set_ini() {
    if grep -qx "$2=$3" "$1"; then return; fi
    sudo sed -i "s/^$2=.*/$2=$3/" "$1"
    if ! grep -qx "$2=$3" "$1"; then
        echo "desktop-final: $1 has no $2= line to set" >&2
        exit 1
    fi
    changed=1
}
# vnc-any and neutrinordp-any are generic proxy sessions the package ships: the login screen offers them with the target
# host and port typed by the client, and nothing here uses them. The sessions of this repository are Xorg and Xvnc.
drop_section() {
    grep -qx "\[$2\]" "$1" || return 0
    local tmp
    tmp=$(mktemp)
    awk -v s="[$2]" '$0 == s { skip = 1; next } /^\[/ { skip = 0 } !skip' "$1" >"$tmp"
    sudo install -m 0644 -o root -g root "$tmp" "$1"
    rm -f "$tmp"
    if grep -qx "\[$2\]" "$1"; then
        echo "desktop-final: $1 still has [$2]" >&2
        exit 1
    fi
    changed=1
}
set_ini /etc/xrdp/xrdp.ini security_layer tls
drop_section /etc/xrdp/xrdp.ini vnc-any
drop_section /etc/xrdp/xrdp.ini neutrinordp-any
set_ini /etc/xrdp/sesman.ini AllowRootLogin false

# no systemd (a container) means no running daemon to restart: the image's entrypoint starts xrdp fresh
if systemctl is-active -q xrdp.service 2>/dev/null; then
    stamp=${XDG_STATE_HOME:-$HOME/.local/state}/djd/xrdp-restart
    if [ -n "$changed" ] || [ ! -e "$stamp" ] || [ /etc/xrdp/xrdp.ini -nt "$stamp" ] || [ /etc/xrdp/sesman.ini -nt "$stamp" ]; then
        # xrdp starts one xrdp-chansrv per RDP session, so a running one means a session is open
        if pgrep -x xrdp-chansrv >/dev/null; then
            echo "desktop-final: an RDP session is open, so xrdp keeps the settings it started with; run 'sudo systemctl restart xrdp xrdp-sesman' after you log out" >&2
        else
            sudo systemctl restart xrdp-sesman.service xrdp.service
            mkdir -p "${stamp%/*}"
            touch "$stamp"
        fi
    fi
fi
