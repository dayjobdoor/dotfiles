#!/usr/bin/env bash
# Exits 1 unless sshd is keys-only with root login denied. Shared by hooks/server-pre-dotfiles and djd doctor.
# On Ubuntu's stock sshd_config layout a converged machine needs no sudo here.
set -euo pipefail

# sshd keeps the first value it reads. Ubuntu's sshd_config includes sshd_config.d before any setting of its
# own, so the drop-in wins unless another drop-in sorts first. Any other layout, such as the one-line
# sshd_config cloud-init writes when openssh-server is missing, is checked against sshd -T, and so are a missing,
# unreadable or corrupted managed drop-in and directives whose values have changed.
# A Match block defeats "first value wins" for the users it matches, so any Match line also forces sshd -T,
# evaluated for the current user from a documentation address (TEST-NET-3). That still cannot see a Match for
# another user or another address, nor a Match in a file outside these two paths. An Include inside a drop-in, and
# a file this user cannot read (cloud-init's 50-cloud-init.conf is 0600), hide settings from the greps in the same
# way, so each of them forces sshd -T too.
first=$(grep -m1 -vE '^[[:space:]]*(#|$)' /etc/ssh/sshd_config || true)
if [ ! -d /etc/ssh/sshd_config.d ]; then
    echo "djd server: /etc/ssh/sshd_config.d does not exist, so the keys-only drop-in is not in place (is openssh-server installed?)" >&2
    exit 1
fi
# nullglob: an empty directory yields no names, not the literal *.conf
earlier=$(cd /etc/ssh/sshd_config.d && shopt -s nullglob && printf '%s\n' *.conf | LC_ALL=C sort | sed '/^10-djd\.conf$/,$d')
match=$(grep -rhiE '^[[:space:]]*(Match|Include)[[:space:]]' /etc/ssh/sshd_config.d 2>/dev/null || true)
match+=$(grep -hiE '^[[:space:]]*Match[[:space:]]' /etc/ssh/sshd_config || true)
unreadable=$(find /etc/ssh/sshd_config /etc/ssh/sshd_config.d -type f ! -readable 2>/dev/null || true)
dropin_ok=
if [ -r /etc/ssh/sshd_config.d/10-djd.conf ]; then
    dropin_ok=yes
    for key in passwordauthentication kbdinteractiveauthentication permitrootlogin; do
        value=$(awk -v key="$key" 'tolower($1) == key { print tolower($2); exit }' /etc/ssh/sshd_config.d/10-djd.conf)
        if [ "$value" != no ]; then
            dropin_ok=
            break
        fi
    done
fi
if [ "$first" != 'Include /etc/ssh/sshd_config.d/*.conf' ] || [ "$dropin_ok" != yes ] || [ -n "$earlier" ] || [ -n "$match" ] || [ -n "$unreadable" ]; then
    # sshd -T needs the privilege separation directory, which only a started ssh.service creates
    sudo install -d -m 0755 /run/sshd
    effective=$(sudo sshd -T -C "user=$(id -un),host=localhost,addr=203.0.113.1")
    for want in 'passwordauthentication no' 'kbdinteractiveauthentication no' 'permitrootlogin no'; do
        if ! grep -qx "$want" <<<"$effective"; then
            echo "djd server: sshd is not keys-only: '$want' is overridden. Check /etc/ssh/sshd_config;" \
                "Ubuntu's default is /usr/share/openssh/sshd_config." >&2
            exit 1
        fi
    done
fi
