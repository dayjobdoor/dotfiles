root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi,php,java,rs,go,sh}]
indent_size = 4

# Shell scripts and zsh startup files without an extension (*.sh is covered above). This section is for editors: `mise run lint` only
# reports shfmt -i 4 differences, and `mise run lint:fix` rewrites them
[{.githooks/*,home/.profile,home/.bash_profile,home/.bashrc,home/.zshenv,home/.config/zsh/*,home/.local/bin/*,home/.xsession,.mise/tasks/**,mise-config/tasks/**,mise-config/hooks/*}]
indent_size = 4

[Makefile]
indent_style = tab

[{.env,.env.*}]
indent_style = tab

[*.{wat,wast,wasm}]
indent_style = tab

[*ignore]
indent_style = tab
