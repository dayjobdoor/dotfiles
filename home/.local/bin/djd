#!/bin/sh
set -eu
# a shell started before `make init` lacks ~/.local/bin, where mise lives
export PATH="$HOME/.local/bin:$PATH"
# djd tasks are plain bash; installing tools belongs to `djd apply`, not to every task run
export MISE_TASK_RUN_AUTO_INSTALL=false
# mise matches the English "Status: active" to detect ufw; under a Japanese locale (the desktop session, or LC_ALL
# forwarded by ssh) the firewall reports drift forever (tests/vm-checks.sh covers it).
export LC_ALL=C.UTF-8
# a MISE_ENV of the user's own would replace the module selection in miserc.local.toml, so `djd module add`
# would write a selection without the machine's modules
unset MISE_ENV
# from $HOME, so a project's mise.toml in the current directory never joins `mise bootstrap`
cd "$HOME"
case "${1:-help}" in
help | -h | --help)
    mise tasks ls --global --no-header | awk '$1 ~ /^djd:/ { sub(/^[[:space:]]*djd:/, ""); print }'
    exit 0
    ;;
esac
cmd=$1
shift
exec mise run "djd:$cmd" "$@"
