#!/usr/bin/env bash
# sec NAME: append NAME=<random> to $ENV_FILE (default .env). A new file is private, and a name that is already there
# is left alone, because a second line would shadow the first without any message.
set -euo pipefail
name=${1:-SECRET}
file=${ENV_FILE:-.env}
# a valid variable name is also a safe regex below: `sec A.B` would otherwise match AXB=, and `sec A=B` would write a line
# that no dotenv reader takes as A or as B
if [[ ! $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    echo "sec: $name is not a valid variable name" >&2
    exit 2
fi
if [[ -f $file ]] && grep -q "^${name}=" "$file"; then
    echo "sec: $name is already in $file" >&2
    exit 1
fi
(
    umask 077
    # a file without a final newline would get the new line glued to its last one
    if [[ -s $file && -n $(tail -c1 "$file") ]]; then printf '\n' >>"$file"; fi
    printf '%s=%s\n' "$name" "$(openssl rand -base64 32)" >>"$file"
)
