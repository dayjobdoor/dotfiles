alias mv="mv -i"
alias cp="cp -i"
alias rm="rm -i"
alias mkdir="mkdir -p"

if command -v ping >/dev/null 2>&1; then
    function ping() {
        command ping -c 3 "${@:-1.1.1.1}"
    }
fi

if command -v xdg-open >/dev/null 2>&1; then
    alias lh="xdg-open http://localhost:3000"
    alias ggg="xdg-open https://youtu.be"
    alias web="xdg-open https://goog.le"
fi

if command -v xsel >/dev/null 2>&1; then
    alias cx="xsel -b -i"
    alias cv="xsel -b -o"
    alias cb="xsel -b"
fi

if command -v lsd >/dev/null 2>&1; then
    alias ls='lsd --group-directories-first'
    alias l='ls -la'
    alias ll='ls -l'
    alias la='ls -a'
    alias lt='ls --tree'
fi

if command -v bat >/dev/null 2>&1; then
    alias cat="bat -p"
fi

if command -v tree >/dev/null 2>&1; then
    # -C only on a terminal: nothing here sets LS_COLORS, so without -C tree is uncolored, and with
    # it a pipe would receive escape codes
    function tree() {
        if [[ -t 1 ]]; then command tree -NC "$@"; else command tree -N "$@"; fi
    }
fi

if command -v openssl >/dev/null 2>&1; then
    # sec NAME: append NAME=<random> to $ENV_FILE (default .env). A new file is private, and a name that is
    # already there is left alone, because a second line would shadow the first without any message
    function sec() {
        local name=${1:-SECRET} file=${ENV_FILE:-.env}
        if [[ -f $file ]] && grep -q "^${name}=" "$file"; then
            print -u2 "sec: $name is already in $file"
            return 1
        fi
        (umask 077; print -r -- "$name=$(openssl rand -base64 32)" >> "$file")
    }
fi
