# ghostty enables its zsh shell integration (cwd for new tabs, prompt jumping, close without asking) only when the
# first word of `command` names zsh; a `$(command -v zsh)` there hides it
command = zsh -l

theme = Kanagawa Dragon

font-family = "HackGen35 Console NF"
font-size = 13.0

# DESIGN.md surface / on-surface; change them there first
background = #112233
foreground = #D4C69A
background-opacity = 0.78

cursor-style = block
cursor-style-blink = true

mouse-hide-while-typing = true

# a file name with an OSC 52 sequence (a directory listing, a prompt, git output) could otherwise overwrite the clipboard
# without a word, because ghostty's default allows clipboard writes from the terminal; set `allow` to get that back
clipboard-write = ask

wait-after-command = true

# a single space hides the title
title = " "

window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
