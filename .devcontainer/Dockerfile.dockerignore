# BuildKit reads this file because it sits next to .devcontainer/Dockerfile and is named after it; the patterns are
# relative to the build context, the repository root. The classic builder (DOCKER_BUILDKIT=0) would ignore it.
# the local overrides and credential files .gitignore lists; docker build sends untracked files too
.git
**/.env
**/.env.*
!**/.env.example
**/*.local.toml
**/*.local
# **/*.local also matches the .local directory name
!home/.local
**/gh/hosts.yml
**/rclone/rclone.conf
**/auth.json
**/*.pem
**/*.key
**/age.txt
.secrets
.vars
**/node_modules
**/.DS_Store
.jj
home/.config/pi/agent/models.json
home/.config/omp/profiles/*/agent/models.yml
