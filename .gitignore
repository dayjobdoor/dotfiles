.env
.env.*
!.env.example
# act secrets and variables (mise run ci passes GITHUB_TOKEN from the environment instead)
.secrets
.vars
*.local.toml
*.local
# *.local also matches the .local directory name
!/home/.local/
**/gh/hosts.yml
**/rclone/rclone.conf
**/auth.json
*.pem
*.key
# age identities (mise defaults to ~/.config/mise/age.txt, which links to mise-config/ in this repo)
age.txt
.DS_Store
node_modules/
# pi and omp model lists hold a Cloudflare account ID in their baseUrls (SECURITY.md); keep them in ~/.config, not here
home/.config/pi/agent/models.json
home/.config/omp/profiles/*/agent/models.yml
# omp creates this lock next to config.yml at run time
home/.config/omp/profiles/*/agent/config.yml.lock
