#!/usr/bin/env bash
#MISE description="Build a Docker image: sandbox (default), desktop or full"
#USAGE arg "[flavor]" default="sandbox" { choices "sandbox" "desktop" "full"; }
set -euo pipefail
cd "$(dirname "$0")/.."

flavor=${usage_flavor:-${1:-sandbox}}
case $flavor in
sandbox) modules=agent ;;
desktop) modules="agent desktop" ;;
full) modules="agent full" ;;
*)
    echo "usage: build [sandbox|desktop|full]" >&2
    exit 2
    ;;
esac
# The token reaches the build only as a BuildKit secret, never as ARG/ENV.
# A token needs no scope; it only lifts the anonymous rate limit (SECURITY.md#github-tokens). No fallback to
# `gh auth token`: it carries every scope of the login, and installs run third-party code.
# GITHUB_TOKEN= (set, empty) runs anonymously.
if [ -z "${GITHUB_TOKEN+x}" ]; then
    echo "$0: set GITHUB_TOKEN to a token without scopes (classic with none, or fine-grained with no permissions), or GITHUB_TOKEN= for none; \`gh auth token\` would hand the installs every scope of your login (SECURITY.md#github-tokens)" >&2
    exit 1
fi
export GITHUB_TOKEN
docker build -f .devcontainer/Dockerfile --build-arg DJD_MODULES="$modules" \
    --build-arg DJD_REVISION="$(git describe --always --dirty 2>/dev/null || echo unknown)" \
    --secret id=github_token,env=GITHUB_TOKEN -t "djd:$flavor" .
