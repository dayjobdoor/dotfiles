#!/usr/bin/env bash
#MISE description="shellcheck, shfmt and zsh -n over every script"
#MISE tools={shellcheck="latest", shfmt="latest"}
#USAGE flag "--fix" help="Rewrite shell formatting instead of reporting it"
set -euo pipefail
cd "$(dirname "$0")/../.."

fix=${usage_fix:-false}

# a read loop, not mapfile: macOS still ships bash 3.2
shell=()
while IFS= read -r f; do shell+=("$f"); done < <(
    printf '%s\n' install.sh home/.profile home/.bash_profile home/.bashrc home/.local/bin/djd desktop/.xsession \
        .devcontainer/desktop-entrypoint.sh .githooks/pre-commit tests/*.sh
    find mise-config/tasks mise-config/hooks mise-tasks -type f
)
shellcheck "${shell[@]}"
# printer flags make shfmt ignore .editorconfig, so -i 4 holds for every script in the list
if [ "$fix" = true ]; then shfmt -i 4 -w "${shell[@]}"; else shfmt -i 4 -d "${shell[@]}"; fi
zsh -n home/.zshenv home/.config/zsh/.zshenv home/.config/zsh/.zshrc home/.config/zsh/.zprofile \
    home/.config/zsh/.zlogin home/.config/zsh/.zlogout home/.config/zsh/.functions
echo "ok shell"
