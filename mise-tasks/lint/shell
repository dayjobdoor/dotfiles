#!/usr/bin/env bash
#MISE description="shellcheck, shfmt and zsh -n over every sh or bash script (found by shebang), the home/ profiles and the zsh startup files"
#MISE tools={shellcheck="latest", shfmt="latest"}
#USAGE flag "--fix" help="Rewrite shell formatting instead of reporting it"
set -euo pipefail
cd "$(dirname "$0")/../.."

fix=${usage_fix:-false}

# A read loop, not mapfile: macOS still ships bash 3.2. The scripts are found by their shebang, not by a
# list, so a new one is checked; no git, because the docker lint run has no .git. The profiles have no shebang.
shell=(home/.profile home/.bash_profile home/.bashrc)
while IFS= read -r -d '' f; do
    # || true: a file without a final newline still fills first, but read exits 1
    IFS= read -r first <"$f" || true
    case $first in
    '#!/bin/sh' | '#!/bin/bash' | '#!/usr/bin/env sh' | '#!/usr/bin/env bash') shell+=("${f#./}") ;;
    esac
done < <(find . \( -name .git -o -name .jj -o -name node_modules -o -name dist \) -prune -o -type f -print0)
shellcheck "${shell[@]}"
# printer flags make shfmt ignore .editorconfig, so -i 4 holds for every script in the list
if [ "$fix" = true ]; then
    shfmt -i 4 -w "${shell[@]}"
elif ! shfmt -i 4 -d "${shell[@]}"; then
    echo "lint: shell is not formatted; run mise run lint:fix" >&2
    exit 1
fi
# one file per call: zsh takes the first operand as the script and the rest as its arguments
for f in home/.zshenv home/.config/zsh/.z* home/.config/zsh/.functions; do zsh -n "$f"; done
echo "ok shell"
