#!/usr/bin/env bash
#MISE description="Markdown links and anchors, and the repo paths, commands and DJD_ variables that the docs name, resolve"
set -euo pipefail
cd "$(dirname "$0")/../.."

# GitHub's heading slugs decide what an anchor is
broken=0
for f in README.md AGENTS.md SECURITY.md DESIGN.md docs/*.md; do
    while IFS= read -r link; do
        case $link in http* | mailto*) continue ;; esac
        path=${link%%#*}
        anchor=
        case $link in *'#'*) anchor=${link#*#} ;; esac
        if [ -z "$path" ]; then target=$f; else target=$(dirname "$f")/$path; fi
        if [ ! -e "$target" ]; then
            echo "lint: $f links to a missing file: $link" >&2
            broken=1
        elif [ -n "$anchor" ] && [ -f "$target" ]; then
            # a here-string, not a pipe: grep -q exiting early would SIGPIPE the producer under pipefail
            slugs=$(grep -E '^#+ ' "$target" | sed -E 's/^#+ +//' | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9 _-]//g; s/ /-/g')
            if ! grep -qx -- "$anchor" <<<"$slugs"; then
                echo "lint: $f links to a missing anchor: $link" >&2
                broken=1
            fi
        fi
    done < <(grep -o '](\([^)]*\))' "$f" | sed 's/^](//; s/)$//' || true)
done

# Inline code spans outside fenced blocks, as FILE<TAB>LINE<TAB>span
docs="README.md AGENTS.md SECURITY.md DESIGN.md llms.txt docs/*.md"
# shellcheck disable=SC2086
spans=$(awk '
    /^[ \t]*```/ { fence = !fence; next }
    fence { next }
    {
        n = split($0, part, "`")
        for (i = 2; i <= n; i += 2) printf "%s\t%d\t%s\n", FILENAME, FNR, part[i]
    }' $docs)

fail() {
    echo "lint: $1:$2: $3" >&2
    broken=1
}

# gitignored, so absent in a fresh checkout
allow_paths=" .devcontainer/.env "
# docs/history.md: planned, not implemented, and removed
allow_cmds=" djd:menu make:age-keygen "

roots=" "
for p in * .[!.]*; do [ "$p" = .git ] || roots="$roots$p "; done
djd=" "
for p in mise-config/tasks/djd/*; do djd="$djd${p##*/} "; done
tasks=" $(find mise-tasks -type f | sed 's|^mise-tasks/||; s|/_default$||; s|/|:|g' | tr '\n' ' ')"
tasks="$tasks $(sed -nE 's/^\[tasks\."?([^]"]+)"?\]$/\1/p' mise.toml | tr '\n' ' ') init help "

while IFS=$'\t' read -r f line span; do
    # 1. repo paths
    for tok in $span; do
        while [[ $tok =~ [,.\;:\)]$ ]]; do tok=${tok%?}; done
        case $tok in '' | '~'* | /* | http* | '$'* | -* | '<'*) continue ;; esac
        case $tok in *[*\<\>{}\[\]\|=@]*) continue ;; esac
        tok=${tok%/}
        case $roots in *" ${tok%%/*} "*) ;; *) continue ;; esac
        case $allow_paths in *" $tok "*) continue ;; esac
        [ -e "$tok" ] || fail "$f" "$line" "missing path: $tok"
    done
    # 2. commands
    while IFS= read -r cmd; do
        [ -n "$cmd" ] || continue
        name=${cmd##* }
        case $name in -* | '<'* | '$'* | '['* | *'<'* | *'|'*) continue ;; esac
        case $cmd in
        make*) ok="$tasks$djd" ;;
        djd*) ok=$djd ;;
        *) ok="$tasks${djd// / djd:}" ;;
        esac
        case $allow_cmds in *" ${cmd%% *}:$name "*) continue ;; esac
        case $ok in *" $name "*) ;; *) fail "$f" "$line" "unknown command: $cmd" ;; esac
    done < <(grep -oE '(mise run|make|djd) [^ ]+' <<<"$span" || true)
done <<<"$spans"

# 3. DJD_ variables
code="install.sh home mise-config mise-tasks tests .devcontainer .github Makefile mise.toml"
# shellcheck disable=SC2086
known=$(grep -rhoE 'DJD_[A-Z_]+' $code | sort -u)
for f in $docs; do
    while IFS=: read -r line var; do
        grep -qxF -- "$var" <<<"$known" || fail "$f" "$line" "variable not found in code: $var"
    done < <(grep -noE 'DJD_[A-Z_]+' "$f" || true)
done

[ "$broken" -eq 0 ] || exit 1
echo "ok docs links, paths, commands and variables"
