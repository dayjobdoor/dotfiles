#!/usr/bin/env bash
#MISE description="mise TOML formatting, task definitions (djd included) and hook ownership"
#USAGE flag "--fix" help="Rewrite TOML formatting instead of reporting it"
set -euo pipefail
cd "$(dirname "$0")/../.."

fix=${usage_fix:-false}

# --stdin, because mise only formats configs it would load from the current directory
for f in mise.toml mise-config/*.toml; do
    formatted=$(mise fmt --stdin <"$f")
    if [ "$fix" = true ]; then
        printf '%s\n' "$formatted" >"$f"
    elif ! diff -u "$f" - <<<"$formatted"; then
        echo "lint: $f is not formatted; run mise run lint:fix" >&2
        exit 1
    fi
done
mise tasks validate
# mise-config as the global config, so the djd tasks and their usage specs are validated too
MISE_CONFIG_DIR="$PWD/mise-config" mise tasks validate
# mise runs the hooks of every selected module, so this is a convention and not a guard: one owner per phase key keeps a phase in one file
dup=$(awk '/^\[/{h=($0=="[bootstrap.hooks]")} h&&!/^[[:space:]]*#/&&/=/{k=$1; gsub(/"/,"",k); print k}' mise-config/config*.toml | sort | uniq -d)
if [ -n "$dup" ]; then
    echo "lint: [bootstrap.hooks] key in more than one module: $dup" >&2
    exit 1
fi
# the mise release is pinned in several places that no bot bumps; they must name the same one
pins=$(
    sed -n 's/^MISE_VERSION=.*v\([0-9.]*\)}"$/\1/p' install.sh
    sed -n 's/^min_version = "\(.*\)"$/\1/p' mise.toml mise-config/config.toml
    sed -n 's/^ *version: \([0-9][0-9.]*\)$/\1/p' .github/workflows/*.yaml
)
if [ -z "$pins" ] || [ "$(sort -u <<<"$pins" | wc -l)" -ne 1 ]; then
    echo "lint: the mise versions in install.sh, mise.toml, mise-config/config.toml and the mise-action pins differ:" >&2
    sort <<<"$pins" | uniq -c >&2
    exit 1
fi
echo "ok mise"
