#!/usr/bin/env bash
#MISE description="Desktop image: every container makes its own xrdp TLS key, xrdp is TLS-only and refuses root logins, an xfreerdp client logs in over RDP and a legacy-layer one is refused, XFCE starts, xrdp-sink is the default audio sink and comes back after wireplumber dies, the four apps launch, ~/.xsession passes its stub test, and the session comes back after a container restart (builds it first)"
#MISE depends=["build desktop"]
#USAGE arg "[image]" default="djd:desktop" help="Image to test"
set -Eeuo pipefail
trap 'echo "FAIL line $LINENO: $BASH_COMMAND" >&2' ERR

image=${usage_image:-${1:-djd:desktop}}
net="djd-rdp-$$"
server="djd-desktop-$$"
client="djd-rdp-client-$$"
control="djd-desktop-negotiate-$$"

# shellcheck disable=SC2329 # invoked by the EXIT trap
cleanup() {
    docker rm -f "$server" "$client" "$control" >/dev/null 2>&1 || true
    docker network rm "$net" >/dev/null 2>&1 || true
}
trap cleanup EXIT

fail() {
    echo "test:desktop: $1" >&2
    docker logs "$server" >&2 || true
    docker exec "$server" sh -c 'tail -n 40 /var/log/xrdp.log /var/log/xrdp-sesman.log' >&2 || true
    docker exec "$client" sh -c 'tail -n 20 /tmp/*.log 2>&1' >&2 || true
    exit 1
}

wait_xrdp() {
    local s=${1:-$server}
    for _ in $(seq 60); do
        if docker exec "$s" bash -c '</dev/tcp/127.0.0.1/3389' 2>/dev/null; then break; fi
        sleep 1
    done
    docker exec "$s" bash -c '</dev/tcp/127.0.0.1/3389' 2>/dev/null || fail "xrdp in $s is not listening on 3389"
}

wait_session() {
    for _ in $(seq 120); do
        docker exec "$server" pgrep -u ubuntu -x xfce4-session >/dev/null && return
        sleep 1
    done
    fail "no xfce4-session for ubuntu after 120s"
}

# pipewire-module-xrdp loads the sink and source from an XDG autostart entry a few seconds after the session starts,
# and its script then makes them the defaults through pactl. The server is the one ~/.xsession started. The sink is
# the only one in a container, so wireplumber picks it without the script; the default source (xrdp-sink.monitor
# otherwise) is what shows the script ran.
check_audio() {
    local uid sink='' src=''
    uid=$(docker exec -u ubuntu "$server" id -u)
    for _ in $(seq 60); do
        sink=$(docker exec -u ubuntu -e "XDG_RUNTIME_DIR=/run/user/$uid" "$server" pactl get-default-sink 2>/dev/null || true)
        [ "$sink" = xrdp-sink ] && break
        sleep 1
    done
    [ "$sink" = xrdp-sink ] || fail "the default audio sink is '${sink:-none}', not xrdp-sink: audio over RDP is not set up"
    echo "test:desktop: xrdp-sink is the default audio sink"
    for _ in $(seq 30); do
        src=$(docker exec -u ubuntu -e "XDG_RUNTIME_DIR=/run/user/$uid" "$server" pactl get-default-source 2>/dev/null || true)
        [ "$src" = xrdp-source ] && break
        sleep 1
    done
    [ "$src" = xrdp-source ] || fail "the default audio source is '${src:-none}', not xrdp-source: the xrdp module script did not set the defaults"
    echo "test:desktop: xrdp-source is the default audio source"
}

# ~/.xsession starts wireplumber again when it dies. The defaults live in wireplumber's metadata, so they must come
# back with the new process, not only the process.
check_wireplumber_respawn() {
    local old new=''
    old=$(docker exec "$server" pgrep -o -u ubuntu -x wireplumber) || fail "no wireplumber is running for ubuntu"
    docker exec "$server" kill "$old"
    for _ in $(seq 30); do
        new=$(docker exec "$server" pgrep -o -u ubuntu -x wireplumber 2>/dev/null || true)
        [ -n "$new" ] && [ "$new" != "$old" ] && break
        new=''
        sleep 1
    done
    [ -n "$new" ] || fail "wireplumber ($old) was killed and not started again within 30 s"
    echo "test:desktop: wireplumber was started again after it died"
    check_audio
}

mkprobe() {
    docker exec "$1" sh -c 'useradd -m probe && echo probe:djd-test-pass | chpasswd'
}

# Exit code of an xfreerdp3 login to HOST as USER (the password of every test account is the same), with
# the log in /tmp/LOG.log of the client. A client that stays connected until SECS gives 124.
rdp_rc() {
    local log=$1 host=$2 user=$3 secs=$4
    shift 4
    docker exec "$client" sh -c \
        "timeout $secs xvfb-run -a xfreerdp3 /v:$host /u:$user /p:djd-test-pass /cert:ignore $* >/tmp/$log.log 2>&1" && echo 0 || echo $?
}

tls_fingerprint() {
    docker exec "$1" openssl x509 -in /etc/xrdp/cert.pem -noout -fingerprint -sha256 || fail "cannot read the certificate of $1"
}

# The entrypoint makes a TLS key for each container. The image keeps the pair that ssl-cert made at build time, and
# anyone who pulls the image has it. Run before the entrypoint, the image's own certificate is that pair.
check_tls_key() {
    local built own other
    built=$(docker run --rm --entrypoint openssl "$image" x509 -in /etc/xrdp/cert.pem -noout -fingerprint -sha256) ||
        fail "cannot read the certificate of the image"
    own=$(tls_fingerprint "$server")
    other=$(tls_fingerprint "$control")
    [ "$own" != "$built" ] || fail "xrdp in the server presents the certificate that is in the image ($built)"
    [ "$other" != "$built" ] || fail "xrdp in the control presents the certificate that is in the image ($built)"
    [ "$own" != "$other" ] || fail "two containers of the image present the same xrdp certificate ($own)"
    echo "test:desktop: each container has its own xrdp TLS key"
}

# $control is the same image with security_layer=negotiate and AllowRootLogin=true. It must accept the legacy-layer
# client, or a client that cannot speak that layer would make the refusal below pass for any server; its xrdp.log
# shows the RDP layer was selected there and refused on $server. The legacy client then tries a second account on
# $server, so a wrongly accepted one would start its own session and leave the first client's alone.
check_legacy_refused() {
    local rc
    mkprobe "$control"
    mkprobe "$server"
    rc=$(rdp_rc legacy-control "$control" probe 20 /sec:rdp)
    [ "$rc" = 124 ] || fail "the control (security_layer=negotiate) did not keep a legacy-layer client connected (exit $rc): the refusal check proves nothing"
    docker exec "$control" grep -qF 'requested [RDP], selected [RDP]' /var/log/xrdp.log ||
        fail "xrdp.log of the control does not show the RDP security layer selected: the refusal check proves nothing"
    rc=$(rdp_rc legacy-server "$server" probe 20 /sec:rdp)
    [ "$rc" != 124 ] || fail "a client forcing the legacy RDP security layer stayed connected: security_layer is not tls"
    [ "$rc" != 0 ] || fail "a client forcing the legacy RDP security layer logged in: security_layer is not tls"
    docker exec "$server" grep -q 'requested \[RDP\], selected \[\]' /var/log/xrdp.log ||
        fail "xrdp.log of the server does not show the legacy-layer request refused (exit $rc): the client ended for another reason"
    if docker exec "$server" pgrep -u probe >/dev/null; then fail "the legacy-layer client got a session"; fi
    docker exec "$server" test -d "/proc/$1" || fail "the first client's xfce4-session ($1) is gone"
    docker exec "$client" pgrep -f 'xfreerdp3 /v:[^ ]* /u:ubuntu ' >/dev/null || fail "the first client lost its connection"
    echo "test:desktop: a legacy-layer client is refused (exit $rc) where security_layer=negotiate accepts it"
}

# A client that is refused at the xrdp login screen stays connected, so the exit code says nothing: the proof is
# the root session that $control starts and $server does not, and the refusal that sesman logs.
check_root_refused() {
    local h up=''
    for h in "$control" "$server"; do
        docker exec "$h" sh -c 'echo root:djd-test-pass | chpasswd'
    done
    rdp_rc root-control "$control" root 15 >/dev/null
    for _ in $(seq 60); do
        if docker exec "$control" pgrep -u root -x xfce4-session >/dev/null; then
            up=1
            break
        fi
        sleep 1
    done
    [ -n "$up" ] || fail "the control (AllowRootLogin=true) started no root session: the root refusal check proves nothing"
    rdp_rc root-server "$server" root 10 >/dev/null
    docker exec "$server" grep -qF 'ROOT login attempted, but root login is disabled' /var/log/xrdp-sesman.log ||
        fail "sesman in the server did not refuse a root login: AllowRootLogin is not false"
    if docker exec "$server" pgrep -u root -x xfce4-session >/dev/null; then fail "a root login on the server started a session"; fi
    echo "test:desktop: root logins are refused where AllowRootLogin=true accepts them"
}

docker network create "$net" >/dev/null
docker run -d --init --name "$server" --network "$net" --user root --entrypoint djd-desktop-entrypoint \
    "$image" ubuntu djd-test-pass >/dev/null
wait_xrdp
docker run -d --init --name "$control" --network "$net" --user root --entrypoint sh "$image" -c \
    "sed -i 's/^security_layer=.*/security_layer=negotiate/' /etc/xrdp/xrdp.ini && sed -i 's/^AllowRootLogin=.*/AllowRootLogin=true/' /etc/xrdp/sesman.ini && exec djd-desktop-entrypoint ubuntu djd-test-pass" >/dev/null

# Install the client before the clock starts; the login itself gets 120s.
docker run -d --name "$client" --network "$net" ubuntu:26.04 sleep infinity >/dev/null
docker exec -e DEBIAN_FRONTEND=noninteractive "$client" sh -c \
    'apt-get -o Acquire::Retries=3 update -qq && apt-get -o Acquire::Retries=3 install -y -qq freerdp3-x11 xvfb procps >/dev/null'
login() {
    docker exec -d "$client" sh -c \
        "xvfb-run -a xfreerdp3 /v:$server /u:ubuntu /p:djd-test-pass /cert:ignore >/tmp/xfreerdp.log 2>&1"
}
login

wait_session
# the fcitx variables that ~/.xsession exports must reach the session. Root cannot read another user's
# /proc/PID/environ in a container (permission denied), the session's owner can.
pid=$(docker exec "$server" pgrep -o -u ubuntu -x xfce4-session)
env=$(docker exec -u ubuntu "$server" sh -c "tr '\\0' '\\n' </proc/$pid/environ")
for v in GTK_IM_MODULE=fcitx QT_IM_MODULE=fcitx XMODIFIERS=@im=fcitx; do
    grep -qx "$v" <<<"$env" || fail "xfce4-session has no $v: it did not start through ~/.xsession"
done
echo "test:desktop: xfce4-session started through ~/.xsession"
wait_xrdp "$control"
check_tls_key
check_legacy_refused "$pid"
check_root_refused
check_audio
check_wireplumber_respawn
docker exec -e DJD_APPS_LAUNCH=1 -u ubuntu "$server" bash -lc 'bash ~/.dotfiles/tests/desktop-apps.sh' || fail "a required desktop app is missing or does not launch"
docker exec -u ubuntu "$server" bash -c 'bash ~/.dotfiles/tests/xsession-audio.sh' || fail "the stub test of ~/.xsession failed"

# /run survives a container restart, so the PipeWire socket of the dead server is still there. ~/.xsession must not
# take it for a live server. The client goes first: left running, it could reconnect to the restarted server and
# make wait_session pass on its session.
docker exec "$client" pkill -x xfreerdp3 || true
docker restart "$server" >/dev/null
wait_xrdp
login
wait_session
echo "test:desktop: xfce4-session started again after a container restart"
check_audio
exit 0
