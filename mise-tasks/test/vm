#!/usr/bin/env bash
#MISE description="Fresh Ubuntu VM (incus, multipass or OrbStack): curl | sh install of server + desktop, hardening, module removal"
# cloud-init, the README's `curl | sh -s -- server desktop` (cloning this tree instead of GitHub), then
# tests/vm-checks.sh inside the VM. Uses the first of incus (CI, Linux), multipass and OrbStack (`orb`) found.
# GITHUB_TOKEN, if set, is handed to mise in the VM. DJD_KEEP_VM=1 keeps the VM after the run, to inspect a failure.
set -euo pipefail
# GitHub lists ::error:: lines as annotations, which `gh run view` shows without the log
# shellcheck disable=SC2329 # invoked by the ERR trap
on_err() {
    echo "FAIL line $1: $2" >&2
    [ -z "${GITHUB_ACTIONS:-}" ] || printf '::error::test:vm line %s: %.300s\n' "$1" "${2//$'\n'/ }"
}
trap 'on_err "$LINENO" "$BASH_COMMAND"' ERR

cd "$(dirname "$0")/../.."
name="djd-test-$$"

if command -v incus >/dev/null 2>&1; then
    vm_create() {
        # nesting lets docker (server module) run inside the system container
        incus launch images:ubuntu/26.04/cloud "$name" -c security.nesting=true \
            -c cloud-init.user-data="$(cat cloud-init/vm.yaml)" >/dev/null
        # all three backends stop here: `status --wait` exits non-zero when cloud-init failed, and its long status says why
        incus exec "$name" -- cloud-init status --wait >/dev/null ||
            {
                incus exec "$name" -- cloud-init status --long >&2
                exit 1
            }
    }
    vm_sh() { incus exec "$name" -- sudo -iu ubuntu bash -c "$1"; }
    vm_delete() { incus delete -f "$name" >/dev/null 2>&1 || true; }
elif command -v multipass >/dev/null 2>&1; then
    vm_create() {
        # the defaults (1 CPU, 1 GB RAM, 5 GB disk) cannot hold the desktop module
        multipass launch 26.04 --name "$name" --cpus 4 --memory 8G --disk 40G --timeout 900 \
            --cloud-init cloud-init/vm.yaml >/dev/null
        multipass exec "$name" -- sudo cloud-init status --wait >/dev/null ||
            {
                multipass exec "$name" -- sudo cloud-init status --long >&2
                exit 1
            }
    }
    vm_sh() { multipass exec "$name" -- bash -lc "$1"; }
    vm_delete() { multipass delete --purge "$name" >/dev/null 2>&1 || true; }
elif command -v orb >/dev/null 2>&1; then
    vm_create() {
        # resolute is the codename of 26.04
        orb create -c cloud-init/vm.yaml ubuntu:resolute "$name" >/dev/null
        orb -m "$name" -w / sudo cloud-init status --wait >/dev/null ||
            {
                orb -m "$name" -w / sudo cloud-init status --long >&2
                exit 1
            }
    }
    # orb starts commands in the host's cwd, where mise would also read the host's mise.toml files
    vm_sh() { orb -m "$name" -w / bash -lc "cd && $1"; }
    vm_delete() { orb delete -f "$name" >/dev/null 2>&1 || true; }
else
    echo "vm: needs incus, multipass or orb (OrbStack)" >&2
    exit 2
fi

trap '[ -n "${DJD_KEEP_VM:-}" ] || vm_delete' EXIT
vm_create
echo "vm: $name is up"

# the token travels on stdin into a 0600 file, never through argv
printf '%s' "${GITHUB_TOKEN:-}" | vm_sh 'umask 077 && cat >~/.djd-github-token'
# tracked and unignored files only: no .env, age.txt or miserc.local.toml (which would change the VM's modules)
tests/tree.sh | vm_sh 'mkdir -p ~/djd-src && tar -xf - -C ~/djd-src'
vm_sh 'git -c init.defaultBranch=main init -q ~/djd-src && cd ~/djd-src && git add -A &&
    git -c user.name=djd -c user.email=djd@localhost commit -qm test'

# single quotes on purpose: these expand inside the VM. install.sh arrives on stdin as from curl, so it clones.
# shellcheck disable=SC2016
vm_sh 'MISE_GITHUB_TOKEN=$(cat ~/.djd-github-token) DJD_REPO="file://$HOME/djd-src" sh -s -- server desktop <~/djd-src/install.sh'
# DJD_TEST_VM: vm-checks.sh refuses to run anywhere else. GITHUB_ACTIONS reaches the VM so that its failures annotate too.
# shellcheck disable=SC2016
vm_sh 'MISE_GITHUB_TOKEN=$(cat ~/.djd-github-token) DJD_TEST_VM=1 GITHUB_ACTIONS='"${GITHUB_ACTIONS:-}"' bash ~/.dotfiles/tests/vm-checks.sh'
echo "vm: ok"
