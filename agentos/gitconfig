# Installed as ~/.gitconfig in agentOS guests. git reads ~/.config/git/config (the shared home/ file) first
# and this file after it, so these win. The guest has no delta or gh, and the shared file points at both;
# the shared file stays untouched because Ubuntu machines do have them.
[core]
	pager = cat

# an empty filter makes `git add -p` show the plain diff
[interactive]
	diffFilter =

# a bare `helper =` resets the list the shared file built
[credential "https://github.com"]
	helper =
[credential "https://gist.github.com"]
	helper =
